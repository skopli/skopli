# frozen_string_literal: true

require "rake/testtask"

begin
  require "rb_sys/extensiontask"

  GEMSPEC = Gem::Specification.load("skopli.gemspec")

  # The argument is the cargo package name (== crate [lib] name == "skopli").
  # The compiled cdylib installs as lib/skopli/skopli.<dlext>, which the
  # pure-Ruby facade require()s.
  RbSys::ExtensionTask.new("skopli", GEMSPEC) do |ext|
    ext.lib_dir = "lib/skopli"
  end
rescue LoadError
  warn "rb_sys/extensiontask unavailable - `rake compile` disabled"
end

Rake::TestTask.new(test: :compile) do |t|
  t.libs << "lib" << "test"
  t.test_files = FileList["test/**/test_*.rb"]
  t.warning = false
end

task default: %i[compile test]
