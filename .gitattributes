golden/** text eol=lf
# Harness stores that are not text (SQLite databases, zstd-compressed logs) must not get
# eol conversion from the golden/** rule above or the files corrupt.
*.db binary
*.sqlite binary
*.sqlite3 binary
*.zst binary
*.zstd binary
# csbindgen writes LF; pin it so the zero-diff regeneration check is stable
# regardless of the platform's checkout EOL setting.
sdks/csharp/Skopli/Native/NativeMethods.g.cs text eol=lf
# scripts/sync-generated.mjs regenerates these and compares bytes; keep them LF everywhere.
*.md text eol=lf
llms.txt text eol=lf
web/docs/src/content/docs/contributing.md linguist-generated=true
