21,"cache_creation_input_tokens":54}},{"id":"message_1792931444791_7123267857117462899","role":"user","content":[{"type":"text","text":"How does resumeNext in index.js decide whether to start the next queued function? One sentence."}],"timestamp":"2026-10-25T12:30:44.791879124Z"},{"id":"message_1792931450915_13673281310267973444","role":"assistant","content":[{"type":"text","text":"The `resumeNext` function in index.js decides whether to start the next queued function by checking if there is a queued function and whether the current function is within its memory limit."}],"timestamp":"2026-10-25T12:30:50.915923805Z","token_usage":{"prompt_tokens":15853,"input_tokens":0,"output_tokens":37,"cache_read_input_tokens":15798,"cache_creation_input_tokens":55}}],"model_usage_turn_id":"session_rhino_1792931357688_b78d67003292c106:message_1792931444791_7123267857117462899","provider_key":"claude-api","model":"claude-sonnet-4-6","reasoning_effort":"none","is_canary":false,"working_dir":"/home/user/project","short_name":"rhino","status":"Active","last_pid":1160949,"last_active_at":"2026-10-25T12:30:51.544775360Z","is_debug":false,"saved":false,"env_snapshots":[{"captured_at":"2026-10-25T12:29:17.701711234Z","reason":"create","session_id":"session_rhino_1792931357688_b78d67003292c106","working_dir":"/home/user/project","provider":"Claude","model":"claude-sonnet-4-6","jcode_version":"v0.98.1 (1c7426eb1)","jcode_git_hash":null,"jcode_git_dirty":null,"os":"linux","arch":"x86_64","pid":1159705,"is_selfdev":false,"is_debug":false,"is_canary":false,"testing_build":null,"working_git":null},{"captured_at":"2026-10-25T12:30:39.101244741Z","reason":"resume","session_id":"session_rhino_1792931357688_b78d67003292c106","working_dir":"/home/user/project","provider":"Claude","model":"claude-sonnet-4-6","jcode_version":"v0.98.1 (1c7426eb1)","jcode_git_hash":null,"jcode_git_dirty":null,"os":"linux","arch":"x86_64","pid":1160515,"is_selfdev":false,"is_debug":false,"is_canary":false,"testing_build