<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The repo root, four levels up from this project directory. -->
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../'))</RepoRoot>
    <!-- The prebuilt cdylib the P/Invoke layer loads at runtime. -->
    <NativeLib Condition="'$(NativeLib)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">$(RepoRoot)target/release/skopli.dll</NativeLib>
    <NativeLib Condition="'$(NativeLib)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">$(RepoRoot)target/release/libskopli.dylib</NativeLib>
    <NativeLib Condition="'$(NativeLib)' == ''">$(RepoRoot)target/release/libskopli.so</NativeLib>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Skopli/Skopli.csproj" />
  </ItemGroup>

  <!--
    Copy the native cdylib into the runtimes/<rid>/native/ layout beside the test
    output, where the SDK's NativeLibraryResolver looks for "skopli". The
    managed assembly is Skopli.Sdk.dll, so it never collides with the native
    skopli.dll. See the SDK README for how the cdylib is located.
  -->
  <Target Name="CopyNativeLib" AfterTargets="Build" Condition="Exists('$(NativeLib)')">
    <Copy SourceFiles="$(NativeLib)"
          DestinationFolder="$(OutDir)runtimes/win-x64/native"
          SkipUnchangedFiles="true" />
    <!-- Also drop it beside the managed assembly: the default AssemblyLoadContext
         native resolver (and the testhost under `dotnet test`) probes the app
         base directory, so this is the location DllImport('skopli') resolves. -->
    <Copy SourceFiles="$(NativeLib)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
