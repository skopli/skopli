---
import { useTranslations, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
  links: { href: string; text: string }[];
}

const { locale, links } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <p class="meta">
      <span>{t("footer.license")}</span>
      <span>{t("footer.copyright", { year })}</span>
    </p>
    <nav class="foot-links" aria-label={t("footer.label")}>
      {links.map((l) => <a href={l.href}>{l.text}</a>)}
    </nav>
    <p class="marks">{t("footer.marks")}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    border-top: 1px solid var(--rule);
    padding-block: var(--space-6) var(--space-7);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr auto;
  }

  .meta,
  .foot-links {
    display: flex;
    align-items: center;
    min-height: var(--hit);
  }

  .meta {
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .foot-links {
    gap: var(--space-2);
  }

  .foot-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit);
    padding-inline: var(--space-2);
    color: var(--fg);
  }

  .marks {
    grid-column: 1 / -1;
    max-width: var(--measure);
  }

  @media (max-width: 767px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
