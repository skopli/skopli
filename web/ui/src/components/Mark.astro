---
// The Skopli mark. Geometry is fixed; only size and colour (currentColor) vary.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  fill-rule="evenodd"
  aria-hidden="true"
  ><path
    d="M12 1 A11 11 0 1 0 12 23 A11 11 0 1 0 12 1 Z M12 3.6 A8.4 8.4 0 1 1 12 20.4 A8.4 8.4 0 1 1 12 3.6 Z"
  ></path><rect x="7.3" y="8.6" width="3.6" height="2.2"></rect><rect
    x="7.3"
    y="12.7"
    width="7.4"
    height="2.2"></rect></svg
>
