---
import { Code } from "astro:components";
import { quickstarts } from "../quickstart.ts";
import Tabs from "./Tabs.astro";

const themes = { light: "github-light", dark: "github-dark" };
---

<Tabs>
  {quickstarts.map((q) => (
    <Fragment slot={q.id}>
      <p class="tabs__install"><code>{q.install}</code></p>
      <Code code={q.code} lang={q.id} themes={themes} defaultColor={false} />
    </Fragment>
  ))}
</Tabs>
