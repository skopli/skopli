---
import { Code } from "astro:components";
import { codeThemes } from "../langs.ts";
import { quickstarts } from "../quickstart.ts";
import Tabs from "./Tabs.astro";
---

<Tabs>
  {quickstarts.map((q) => (
    <Fragment slot={q.id}>
      <p class="tabs__install">
        <code>{q.install}</code>
        {q.note && <span>{q.note}</span>}
      </p>
      <Code code={q.code} lang={q.id} themes={codeThemes} defaultColor={false} />
    </Fragment>
  ))}
</Tabs>
