---
import { languages } from "../data/languages.ts";
import { t, type Locale } from "../i18n/index.ts";
interface Props {
  locale?: Locale;
  compact?: boolean;
}
const { locale = "en", compact = false } = Astro.props;
---

<div class:list={["lang-switch", { compact }]} role="tablist" aria-label={t(locale, "lang.label")}
  data-fallback={t(locale, "lang.fallback")}
  data-lang-switch
>
  {
    languages.map((l) => (
      <button type="button" role="tab" data-lang={l.id} aria-selected="false">
        {l.name}
      </button>
    ))
  }
</div>

<style>
  .lang-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-1);
    border-bottom: var(--rule) solid var(--rule-color);
  }
  [role="tab"] {
    min-height: var(--target);
    padding: 0 var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    border-bottom: var(--rule-heavy) solid transparent;
    margin-bottom: -1px;
    transition: color var(--duration) var(--ease-out);
  }
  [role="tab"]:hover {
    color: var(--fg);
  }
  [role="tab"][aria-selected="true"] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }
  .compact [role="tab"] {
    padding: 0 var(--space-2);
    font-size: var(--text-xs);
  }
</style>

<script>
  const KEY = "skopli.lang";
  const root = document.documentElement;
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-lang-switch] [role=tab]");
  const apply = () => {
    for (const tab of tabs) {
      const on = tab.dataset.lang === root.dataset.lang;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
    }
    const current = tabs[0]?.closest<HTMLElement>("[data-lang-switch]");
    const name = (id?: string) => current?.querySelector(`[data-lang="${id}"]`)?.textContent ?? id ?? "";
    for (const set of document.querySelectorAll<HTMLElement>(".code-tabs")) {
      const has = set.querySelector(`.code-tab[data-lang="${root.dataset.lang}"]`);
      set.toggleAttribute("data-fallback", !has);
      let note = set.querySelector<HTMLParagraphElement>(".code-fallback");
      if (!note) {
        note = document.createElement("p");
        note.className = "code-fallback";
        set.prepend(note);
      }
      const shown = set.querySelector<HTMLElement>(".code-tab")?.dataset.lang;
      note.textContent = (current?.dataset.fallback ?? "")
        .replace("{lang}", name(root.dataset.lang))
        .replace("{shown}", name(shown));
    }
  };
  apply();
  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      root.dataset.lang = tab.dataset.lang;
      try {
        localStorage.setItem(KEY, tab.dataset.lang ?? "ts");
      } catch {}
      apply();
    });
    tab.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const list = [...tab.parentElement!.querySelectorAll<HTMLButtonElement>("[role=tab]")];
      const next = list[(list.indexOf(tab) + (e.key === "ArrowRight" ? 1 : list.length - 1)) % list.length];
      next?.focus();
      next?.click();
    });
  }
</script>
