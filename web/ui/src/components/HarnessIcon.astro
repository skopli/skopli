---
import { harnessIconPaths, type HarnessIconSlug } from "../data/harness-icons.ts";

interface Props {
  id: string;
}

const path = harnessIconPaths[Astro.props.id as HarnessIconSlug];
---

{
  path ? (
    <svg
      class="harness-icon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="currentColor"
      aria-hidden="true"
      set:html={path}
    />
  ) : (
    <span class="harness-icon" aria-hidden="true" />
  )
}

<style>
  .harness-icon {
    flex: none;
    display: inline-block;
    width: 18px;
    height: 18px;
    vertical-align: -0.2em;
  }
</style>
