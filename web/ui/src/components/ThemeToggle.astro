---
import Icon from "./Icon.astro";
import { useTranslations, type Locale } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<button class="icon-btn theme-toggle" type="button" data-theme-toggle
  aria-label={t("theme.label")}
  data-to-light={t("theme.toLight")}
  data-to-dark={t("theme.toDark")}
>
  <Icon name="sun" class="when-dark" />
  <Icon name="moon" class="when-light" />
</button>

<style>
  .theme-toggle :global(svg) {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle :global(.when-dark),
  :global([data-theme="light"]) .theme-toggle :global(.when-light) {
    display: block;
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const label = () => {
      const dark = document.documentElement.dataset.theme === "dark";
      button.setAttribute("aria-label", dark ? button.dataset.toLight! : button.dataset.toDark!);
    };
    label();
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("theme", next);
      label();
    });
  }
</script>
