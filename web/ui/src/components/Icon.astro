---
const files = import.meta.glob<string>("../icons/*.svg", { query: "?raw", import: "default", eager: true });

interface Props {
  name?: string;
  size?: number;
}

const { name, size = 16 } = Astro.props;
const svg = name ? files[`../icons/${name}.svg`]?.replace(/<title>.*?<\/title>/, "") : "";
if (name && !svg) throw new Error(`unknown icon: ${name}`);
---

<span class="icon" style={`--icon-size:${size}px`} aria-hidden="true" set:html={svg} />

<style>
  .icon {
    display: inline-flex;
    flex: none;
    width: var(--icon-size);
    height: var(--icon-size);
    color: var(--ink-2);
  }

  .icon :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
