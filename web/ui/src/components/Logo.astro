---
import dark from "../assets/skopli-mark-dark.svg?raw";
import light from "../assets/skopli-mark-light.svg?raw";

interface Props {
  href: string;
  label?: string;
  size?: number;
}

const { href, label = "Skopli", size = 24 } = Astro.props;
---

<a class="logo" href={href} aria-label={`${label} home`}>
  <span class="logo__mark logo__mark--light" style={`--size:${size}px`} set:html={light} />
  <span class="logo__mark logo__mark--dark" style={`--size:${size}px`} set:html={dark} />
  <span class="logo__word">{label}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .logo__mark {
    display: inline-flex;
    width: var(--size);
    height: var(--size);
  }
  .logo__mark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .logo__mark--dark {
    display: none;
  }
  :global([data-theme="dark"]) .logo__mark--light {
    display: none;
  }
  :global([data-theme="dark"]) .logo__mark--dark {
    display: inline-flex;
  }
</style>
