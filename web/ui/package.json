{
  "name": "@skopli/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*",
    "./data/*": "./src/data/*.ts",
    "./i18n": "./src/i18n/index.ts",
    "./analytics": "./src/analytics.ts"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "typecheck": "astro check --tsconfig tsconfig.json",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.10.1",
    "astro": "7.3.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
