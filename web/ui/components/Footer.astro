---
import type { Translate } from "../i18n/index.ts";
import BrandMark from "./BrandMark.astro";

interface Props {
  t: Translate;
  layout?: "page" | "docs";
  licenseHref: string;
  privacyHref: string;
}

const { t, layout = "page", licenseHref, privacyHref } = Astro.props;
---

<footer class:list={["site-footer", `site-footer--${layout}`]}>
  <div class="site-footer__in">
    <div class="site-footer__brand">
      <span class="site-footer__mark"><BrandMark size={18} /> Skopli</span>
      <p class="site-footer__note">{t("siteFooterNote")}</p>
    </div>
    <nav class="site-footer__nav" aria-label={t("footerNavigation")}>
      <slot />
    </nav>
    <p class="site-footer__legal">
      <a href={licenseHref} rel="noopener">{t("license")}</a> · <a href={privacyHref}>{t("privacy")}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--hair) solid var(--rule-1);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .site-footer__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-4) var(--s-6);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--s-6) var(--s-5);
  }
  .site-footer--docs .site-footer__in {
    max-width: none;
  }
  .site-footer__brand {
    display: grid;
    gap: var(--s-2);
    max-width: 32rem;
  }
  .site-footer__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    color: var(--ink-0);
    font-weight: 600;
  }
  .site-footer__note {
    margin: 0;
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--s-2);
  }
  .site-footer__nav :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--s-2);
    color: var(--ink-2);
    text-decoration: none;
  }
  .site-footer__nav :global(a:hover) {
    color: var(--ink-0);
  }
  .site-footer__legal {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink-3);
  }
  .site-footer__legal a {
    display: inline-block;
    min-height: var(--target);
    line-height: var(--target);
    color: var(--ink-2);
    text-decoration: none;
  }
  .site-footer__legal a:hover {
    color: var(--ink-0);
  }
  @media (max-width: 47.99rem) {
    .site-footer__in {
      grid-template-columns: 1fr;
      padding: var(--s-6) var(--s-4);
    }
    .site-footer__nav {
      margin-inline-start: calc(-1 * var(--s-2));
    }
  }
</style>
