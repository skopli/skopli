---
import { harnesses } from "../data/harnesses.ts";
import HarnessIcon from "./HarnessIcon.astro";

interface Props {
  id: string;
}

const harness = harnesses.find((h) => h.id === Astro.props.id);
if (!harness) throw new Error(`unknown harness id: ${Astro.props.id}`);
---

<span class="harness-name">
  <span class="harness-name__icon"><HarnessIcon slug={harness.icon} /></span>
  {harness.name}
</span>
