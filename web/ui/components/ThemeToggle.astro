---
import type { Translate } from "../i18n/index.ts";

interface Props {
  t: Translate;
}

const { t } = Astro.props;
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label-light={t("switchToLight")}
  data-label-dark={t("switchToDark")}
  aria-label={t("switchToLight")}
>
  <svg
    class="theme-toggle__sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    class="theme-toggle__moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--target);
    min-height: var(--target);
    padding: 0;
    border: 0;
    border-radius: var(--r-2);
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--ink-0);
    background: var(--ground-2);
  }
  .theme-toggle__moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-toggle__sun {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme-toggle__moon {
    display: block;
  }
</style>

<script>
  const root = document.documentElement;
  const apply = (theme: "light" | "dark") => {
    root.dataset.theme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", getComputedStyle(root).getPropertyValue("--ground-0").trim());
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.setAttribute(
        "aria-label",
        (theme === "dark" ? button.dataset.labelLight : button.dataset.labelDark) ?? "",
      );
    }
  };
  apply(root.dataset.theme === "light" ? "light" : "dark");
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    button.addEventListener("click", () => {
      const next = root.dataset.theme === "light" ? "dark" : "light";
      apply(next);
      try {
        localStorage.setItem("skopli-theme", next);
      } catch {
        /* storage unavailable */
      }
    });
  }
</script>
