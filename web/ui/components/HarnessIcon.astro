---
import { harnessIconPaths, type HarnessIconSlug } from "../data/harness-icons.ts";

interface Props {
  slug?: HarnessIconSlug;
}

const { slug } = Astro.props;
---

<svg
  class="harness-icon"
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  set:html={slug ? harnessIconPaths[slug] : ""}
/>
