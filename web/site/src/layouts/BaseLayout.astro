---
import "@skopli/ui/tokens.css";
import "@skopli/ui/base.css";
import "@skopli/ui/prose.css";
import "@skopli/ui/shiki.css";
import tokens from "@skopli/ui/tokens.css?raw";
import Analytics from "@skopli/ui/components/Analytics.astro";
import Fonts from "@skopli/ui/components/Fonts.astro";
import TabsInit from "@skopli/ui/components/TabsInit.astro";
import ThemeScript from "@skopli/ui/components/ThemeScript.astro";
import { defaultLocale, type Locale, ogLocale, translator } from "@skopli/ui/i18n";
import { absoluteHref, locales } from "../lib/i18n.ts";
import { copyFor } from "../copy.ts";
import { licenseUrl, repoUrl, siteOrigin } from "../site.ts";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
}

const { locale, title, description, path, noindex = false } = Astro.props;
const canonical = absoluteHref(path, locale);
const t = translator(locale);
const themeColor = /--ground-0:\s*(#[0-9a-f]{6})/i.exec(tokens)?.[1];
if (!themeColor) throw new Error("tokens.css defines no --ground-0");
const alternates = noindex || locales.length === 1 ? [] : locales;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: String(Astro.site),
      name: "Skopli",
      inLanguage: locale,
      publisher: { "@type": "Organization", name: "Skopli", url: siteOrigin },
    },
    {
      "@type": "SoftwareSourceCode",
      name: "Skopli",
      description,
      codeRepository: repoUrl,
      license: licenseUrl,
      programmingLanguage: ["TypeScript", "Python", "Rust", "Ruby", "Java", "C#", "Go", "Swift", "C"],
      isAccessibleForFree: true,
      url: String(Astro.site),
    },
  ],
};
---

<!doctype html>
<html
  lang={locale}
  dir="ltr"
  data-copy-label={t("copyCode")}
  data-copied-label={t("copied")}
  data-copy-failed-label={t("copyFailed")}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt} href={absoluteHref(path, alt)} />)}
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={absoluteHref(path, defaultLocale)} />
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skopli" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:image" content={`${siteOrigin}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={copyFor(locale).hero.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={themeColor} />
    <ThemeScript />
    <TabsInit />
    <Fonts />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body>
    <slot />
    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100dvh;
      }
      body > :global(main) {
        flex: 1;
      }
    </style>
    <script>
      import { initCopyCode } from "@skopli/ui/markdown/copy-code.ts";
      import { initScrollOverflow } from "@skopli/ui/markdown/scroll-overflow.ts";

      const { copyLabel, copiedLabel, copyFailedLabel } = document.documentElement.dataset;
      initCopyCode({
        copy: copyLabel ?? "Copy code",
        copied: copiedLabel ?? "Copied",
        failed: copyFailedLabel ?? "Copy failed",
      });
      initScrollOverflow();
    </script>
  </body>
</html>
