---
import '../styles/tokens.css';
import '../styles/landing.css';
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem("skopli-theme");
      if (t === "light" || t === "dark") {
        document.documentElement.setAttribute("data-theme", t);
      }
    } catch (e) {}
  })();
</script>
<title>Skopli, the ledger for AI coding-agent usage</title>
<meta name="description" content="An open-source SDK that reads AI coding-agent usage from 40 harnesses locally, rolls it up, and prices it against live market catalogs. 9 languages, one Rust core. MIT.">
<link rel="canonical" href="https://skopli.com/">
<meta property="og:type" content="website">
<meta property="og:url" content="https://skopli.com/">
<meta property="og:title" content="Skopli, the ledger for AI coding-agent usage">
<meta property="og:description" content="An open-source SDK that reads AI coding-agent usage from 40 harnesses locally, rolls it up, and prices it against live market catalogs. 9 languages, one Rust core.">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Skopli, the ledger for AI coding-agent usage">
<meta name="twitter:description" content="Read AI coding-agent usage from 40 harnesses, offline, and price it against live market catalogs.">
