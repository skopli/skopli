---
import "@skopli/ui/styles/base.css";
import "@skopli/ui/styles/shiki.css";
import "@skopli/ui/styles/tabs.css";
import Footer from "@skopli/ui/components/Footer.astro";
import Head from "@skopli/ui/components/Head.astro";
import Logo from "@skopli/ui/components/Logo.astro";
import ThemeInit from "@skopli/ui/components/ThemeInit.astro";
import ThemeToggle from "@skopli/ui/components/ThemeToggle.astro";
import { langs } from "@skopli/ui/langs";
import { project } from "@skopli/ui/project";
import { published } from "@skopli/ui/quickstart";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { docs, github, site } = project;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebSite", name: project.name, url: site, description },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: project.name,
    description,
    url: site,
    codeRepository: github,
    license: project.license,
    programmingLanguage: Object.values(langs),
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Head
      documentTitle={title}
      {title}
      {description}
      url={site}
      siteName={project.name}
      type="website"
      image={`${site}og.png`}
      markdown={`${site}llms.txt`}
      {jsonLd}
    />
    <ThemeInit />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="top">
      <div class="top__inner">
        <Logo href="/" />
        <nav class="top__nav" aria-label="Primary">
          <a href={docs}>Docs</a>
          <a href="#harnesses">Harnesses</a>
          <a href={github}>GitHub</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <Footer
      links={[
        { label: "Docs", href: docs },
        { label: "GitHub", href: github },
        ...(published ? [{ label: "npm", href: "https://www.npmjs.com/package/skopli" }] : []),
        { label: "llms.txt", href: `${docs}llms.txt` },
      ]}
    />
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .top__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-2) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .top__nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .top__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-3);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    color: var(--ink-2);
    text-decoration: none;
  }
  .top__nav a:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  @media (max-width: 480px) {
    .top__nav a:nth-child(2) {
      display: none;
    }
  }
</style>
