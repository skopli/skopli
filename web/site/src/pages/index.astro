---
import CodeBlock from "@skopli/ui/components/CodeBlock.astro";
import HarnessIcon from "@skopli/ui/components/HarnessIcon.astro";
import InstallTabs from "@skopli/ui/components/InstallTabs.astro";
import Icon from "@skopli/ui/components/Icon.astro";
import T from "@skopli/ui/components/T.astro";
import { HARNESSES } from "@skopli/ui/data/harnesses";
import { localeFromPath, useTranslations, type Key } from "@skopli/ui/i18n";
import SiteLayout from "../layouts/SiteLayout.astro";
import PricedLedger from "../components/PricedLedger.astro";

const locale = localeFromPath(Astro.url.pathname, import.meta.env.BASE_URL);
const t = useTranslations(locale);
const docs = "https://docs.skopli.com/skopli/";
const quickstart = `import { readUsage, rollup, createPricing } from "skopli";

const { events } = await readUsage({ since: "2026-08-01" });
const byModel = rollup(events, { by: "model" });
const priced = await createPricing().priceRollups(byModel);

for (const row of priced) {
  if (row.pricing.priced) console.log(row.key, row.pricing.usd.toFixed(2));
  else console.log(row.key, "unpriced, tried", row.pricing.attempted);
}`;
const layers = [
  { name: "read", what: "home.layers.read", net: "home.layers.net.never" },
  { name: "rollup", what: "home.layers.rollup", net: "home.layers.net.never" },
  { name: "price", what: "home.layers.price", net: "home.layers.net.price" },
] satisfies { name: string; what: Key; net: Key }[];
const refusals = ["guess", "telemetry", "account", "double"] as const;
const [refBefore, refAfter] = t("home.harness.linkP", { link: "|" }).split("|");
---

<SiteLayout title={t("site.homeTitle")} description={t("site.homeDescription")}>
  <section class="hero">
    <div class="pitch">
      <h1>{t("home.h1")}</h1>
      <p class="lede">{t("home.lede")}</p>
      <p class="ctas">
        <a class="btn primary" href={docs}>{t("home.cta.docs")}</a>
        <a class="btn" href="https://github.com/skopli/skopli" target="_blank" rel="noopener">
          {t("home.cta.github")}
          <Icon name="external" size={14} />
        </a>
      </p>
    </div>
    <PricedLedger locale={locale} />
  </section>

  <section>
    <h2>{t("home.layers.h2")}</h2>
    <table class="layers stack-table">
      <thead>
        <tr>
          <th scope="col">{t("home.layers.col.layer")}</th>
          <th scope="col">{t("home.layers.col.what")}</th>
          <th scope="col">{t("home.layers.col.network")}</th>
        </tr>
      </thead>
      <tbody>
        {
          layers.map((l) => (
            <tr>
              <th scope="row">
                <code>{l.name}</code>
              </th>
              <td data-label={t("home.layers.col.what")}>
                <T k={l.what} />
              </td>
              <td data-label={t("home.layers.col.network")} class="net">
                {t(l.net)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="after">{t("home.library.p")}</p>
  </section>

  <section>
    <h2>{t("home.quick.h2")}</h2>
    <CodeBlock code={quickstart} lang="ts" />
    <p class="after">{t("home.quick.p")} <a href={`${docs}reference/api/`}>{t("home.quick.link")}</a>.</p>
  </section>

  <section>
    <h2>{t("home.install.h2")}</h2>
    <p>{t("home.install.p")}</p>
    <InstallTabs />
  </section>

  <section>
    <h2>{t("home.harness.h2")}</h2>
    <p><T k="home.harness.p" /></p>
    <ul class="harnesses">
      {
        HARNESSES.map((h) => (
          <li>
            <HarnessIcon id={h.id} />
            <span>{h.name}</span>
            <code>{h.id}</code>
          </li>
        ))
      }
    </ul>
    <p class="after">
      {refBefore}<a href={`${docs}reference/harnesses/`}>{t("home.harness.link")}</a>{refAfter}
    </p>
  </section>

  <section>
    <h2>{t("home.refuse.h2")}</h2>
    <dl class="refusals">
      {
        refusals.map((r) => (
          <div>
            <dt>{t(`home.refuse.${r}.dt`)}</dt>
            <dd>
              <T k={`home.refuse.${r}.dd`} />
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--space-8);
      padding-top: var(--space-8);
    }
  }

  .pitch h1 {
    max-width: 14ch;
    text-wrap: balance;
    letter-spacing: var(--tracking-display);
  }

  .pitch .lede {
    max-width: 44ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .btn.primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .layers tbody th {
    font-size: var(--text-lg);
    font-weight: 400;
    white-space: nowrap;
  }

  .layers .net {
    color: var(--fg-muted);
  }

  @media (min-width: 48rem) {
    .layers th:first-child {
      width: 8rem;
    }

    .layers .net {
      width: 36%;
    }
  }

  section > :global(pre),
  section > :global(.tabs) {
    max-width: 46rem;
    margin-top: var(--space-5);
  }

  .after {
    margin-top: var(--space-5);
  }

  .harnesses {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    column-gap: var(--space-6);
  }

  .harnesses li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--hit);
    border-bottom: 1px solid var(--rule);
  }

  .harnesses code {
    margin-left: auto;
    white-space: nowrap;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .refusals {
    margin: 0;
  }

  .refusals > div {
    display: grid;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .refusals > div:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .refusals dt {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  .refusals dd {
    margin: 0;
    max-width: var(--measure);
  }

  @media (min-width: 48rem) {
    .refusals > div {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }
</style>
