<script is:inline>
(function () {
  var root = document.documentElement;

  // Theme toggle. Persist under skopli-theme (pre-paint script sets initial)
  var toggle = document.getElementById("themeToggle");
  if (toggle) {
    toggle.addEventListener("click", function () {
      var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("skopli-theme", next); } catch (e) {}
    });
  }

  // Language tab strip. Switch panels, persist under skopli-lang, keyboard-accessible
  var LANG_KEY = "skopli-lang";
  function selectLang(lang, focusBtn) {
    document.querySelectorAll(".tabstrip").forEach(function (strip) {
      strip.querySelectorAll("button").forEach(function (b) {
        var on = b.dataset.lang === lang;
        b.setAttribute("aria-selected", on ? "true" : "false");
        b.tabIndex = on ? 0 : -1;
        if (on && focusBtn) b.focus();
      });
    });
    document.querySelectorAll(".panels").forEach(function (group) {
      group.querySelectorAll(".panel").forEach(function (p) {
        p.setAttribute("data-open", p.dataset.lang === lang ? "true" : "false");
      });
    });
    try { localStorage.setItem(LANG_KEY, lang); } catch (e) {}
  }

  // Install command copy buttons
  document.querySelectorAll(".copy-btn, .pm-chip").forEach(function (btn) {
    btn.addEventListener("click", function () {
      navigator.clipboard.writeText(btn.dataset.copy).then(function () {
        btn.setAttribute("data-copied", "true");
        setTimeout(function () { btn.removeAttribute("data-copied"); }, 1600);
      });
    });
  });

  var start = null;
  try { start = localStorage.getItem(LANG_KEY); } catch (e) {}
  if (start) selectLang(start, false);

  document.querySelectorAll(".tabstrip").forEach(function (strip) {
    var btns = Array.prototype.slice.call(strip.querySelectorAll("button"));
    btns.forEach(function (btn, i) {
      btn.addEventListener("click", function () { selectLang(btn.dataset.lang, false); });
      btn.addEventListener("keydown", function (e) {
        var next = null;
        if (e.key === "ArrowRight") next = btns[(i + 1) % btns.length];
        else if (e.key === "ArrowLeft") next = btns[(i - 1 + btns.length) % btns.length];
        else if (e.key === "Home") next = btns[0];
        else if (e.key === "End") next = btns[btns.length - 1];
        if (next) { e.preventDefault(); selectLang(next.dataset.lang, true); }
      });
    });
  });
})();
</script>

