---
import HarnessTable from "@skopli/ui/components/HarnessTable.astro";
import InstallTabs from "@skopli/ui/components/InstallTabs.astro";
import Icon from "@skopli/ui/components/Icon.astro";
import CodeBlock from "@skopli/ui/components/CodeBlock.astro";
import { localeFromPath, useTranslations } from "@skopli/ui/i18n";
import SiteLayout from "../layouts/SiteLayout.astro";
import PricedLedger from "../components/PricedLedger.astro";

const locale = localeFromPath(Astro.url.pathname, import.meta.env.BASE_URL);
const t = useTranslations(locale);
const docs = "https://docs.skopli.com/skopli/";
const quickstart = `import { readUsage, rollup, createPricing } from "skopli";

const { events } = await readUsage({ since: "2026-08-01" });
const byModel = rollup(events, { by: "model" });
const priced = await createPricing().priceRollups(byModel);

for (const row of priced) {
  if (row.pricing.priced) console.log(row.key, row.pricing.usd.toFixed(2));
  else console.log(row.key, "unpriced; tried", row.pricing.attempted.join(", "));
}`;
const layers = [
  { name: "read", returns: t("home.layers.read"), net: t("home.layers.net.never") },
  { name: "rollup", returns: t("home.layers.rollup"), net: t("home.layers.net.never") },
  { name: "price", returns: t("home.layers.price"), net: t("home.layers.net.price") },
];
const refusals = ["guess", "telemetry", "account", "double"] as const;
---

<SiteLayout title={t("site.homeTitle")} description={t("site.homeDescription")}>
  <section class="hero">
    <div class="pitch">
      <h1>{t("home.h1")}</h1>
      <p class="lede">{t("home.lede")}</p>
      <p class="ctas">
        <a class="btn primary" href={docs}>{t("home.cta.docs")}</a>
        <a class="btn" href="https://github.com/skopli/skopli" target="_blank" rel="noopener">
          {t("home.cta.github")}
          <Icon name="external" size={14} />
        </a>
      </p>
    </div>
    <PricedLedger locale={locale} />
  </section>

  <section>
    <h2>{t("home.layers.h2")}</h2>
    <dl class="layers">
      <div class="head" aria-hidden="true">
        <dt>{t("home.layers.col.layer")}</dt>
        <dd>{t("home.layers.col.returns")}</dd>
        <dd>{t("home.layers.col.network")}</dd>
      </div>
      {
        layers.map((l) => (
          <div>
            <dt><code>{l.name}</code></dt>
            <dd>{l.returns}</dd>
            <dd class="net">{l.net}</dd>
          </div>
        ))
      }
    </dl>
    <p>{t("home.library.p")}</p>
  </section>

  <section class="prose quick">
    <h2>{t("home.quick.h2")}</h2>
    <CodeBlock code={quickstart} lang="ts" />
    <p>{t("home.quick.p")} <a href={`${docs}reference/api/`}>{t("home.quick.link")}</a>.</p>
  </section>

  <section class="prose">
    <h2>{t("home.install.h2")}</h2>
    <p>{t("home.install.p")}</p>
    <InstallTabs />
  </section>

  <section class="prose">
    <h2>{t("home.harness.h2")}</h2>
    <p>{t("home.harness.p")}</p>
    <HarnessTable />
  </section>

  <section>
    <h2>{t("home.refuse.h2")}</h2>
    <dl class="refusals">
      {
        refusals.map((r) => (
          <div>
            <dt>{t(`home.refuse.${r}.dt`)}</dt>
            <dd>{t(`home.refuse.${r}.dd`)}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--space-8);
      padding-top: var(--space-8);
    }
  }

  .pitch h1 {
    max-width: 14ch;
    text-wrap: balance;
    letter-spacing: var(--tracking-display);
  }

  .pitch .lede {
    margin-top: var(--space-5);
    max-width: 44ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .btn.primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .layers,
  .refusals {
    margin: 0;
  }

  .layers > div,
  .refusals > div {
    display: grid;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .layers > div:last-of-type,
  .refusals > div:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .layers .head {
    display: none;
  }

  .layers dt {
    font-size: var(--text-lg);
  }

  .layers dd,
  .refusals dd {
    margin: 0;
    max-width: var(--measure);
  }

  .layers .net {
    color: var(--fg-muted);
  }

  .refusals dt {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
  }

  @media (min-width: 48rem) {
    .layers > div,
    .refusals > div {
      grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 1fr);
    }

    .refusals > div {
      grid-template-columns: 14rem minmax(0, 1fr);
    }

    .layers .head {
      display: grid;
      padding-block: var(--space-2);
      border-top: 0;
      font: 600 var(--text-xs) / 1.4 var(--font-sans);
      color: var(--fg-muted);
    }
  }

  .quick :global(pre) {
    margin-block: var(--space-5);
  }
</style>
