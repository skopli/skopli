---
import { Code } from "astro:components";
import type { BundledLanguage } from "shiki";
import { codeThemes } from "@skopli/ui/code-theme.ts";
import { harnesses, unsupported } from "@skopli/ui/data/harnesses.ts";
import { languages } from "@skopli/ui/data/languages.ts";
import { t } from "@skopli/ui/i18n/index.ts";
import LangSwitch from "@skopli/ui/components/LangSwitch.astro";
import fixture from "../../../../golden/pricing/basic/expected-priced-rollup.json";
import SiteLayout from "../layouts/SiteLayout.astro";

const locale = "en";
const docs = "https://docs.skopli.com/skopli/";
const repo = "https://github.com/skopli/skopli";
const num = new Intl.NumberFormat("en");
const usd = (v: number) => `$${v.toFixed(4)}`;
type Pricing =
  | { priced: true; usd: number; source: string; fetchedAt: string }
  | { priced: false; attempted: string[] };
const rows = fixture.rollups.map((r) => ({ ...r, pricing: r.pricing as Pricing }));

const layers = [
  { name: "Read", docs: "guide/reading/", network: "No network", text: "Detects the agents on this machine and reads the session files they already wrote. Every event carries the model, five disjoint token counters, the harness id and a timestamp; files it cannot parse come back as diagnostics, not as guesses." },
  { name: "Rollup", docs: "guide/rollups/", network: "No network", text: "Sums events by model, day, session, harness, workspace or activity block. Counts stay separate: events, turns and calls are three different numbers. Pass tz so days split where you expect." },
  { name: "Price", docs: "guide/pricing-basics/", network: "Fetches by default, works offline", text: "Matches each model against three public catalogs, fetched by default and cached on disk. A model it cannot find stays unpriced and lists what it tried. Pass sources: [] or your own table and no request is made." },
];

const offline = [
  { id: "ts", shiki: "ts", code: `import { createPricing } from "skopli";

// Serve prices from the on-disk cache only.
const cached = createPricing({ offline: true });

// No market sources at all: price from your own table only.
const fixed = createPricing({
  sources: [],
  overrides: [{ model: "claude-sonnet-4.5", input: 3, output: 15, cacheRead: 0.3, cacheWrite: 3.75 }],
});` },
  { id: "py", shiki: "python", code: `cached = skopli.create_pricing(offline=True)
fixed = skopli.create_pricing(sources=[], overrides=[{"model": "claude-sonnet-4.5", "input": 3, "output": 15}])` },
  { id: "ruby", shiki: "ruby", code: `cached = Skopli.create_pricing(offline: true)
fixed = Skopli.create_pricing(sources: [], overrides: [{ model: "claude-sonnet-4.5", input: 3, output: 15 }])` },
  { id: "go", shiki: "go", code: `cached, _ := skopli.NewPricing(skopli.PricingOptions{Offline: true})` },
  { id: "java", shiki: "java", code: `var cached = Skopli.createPricing(PricingOptions.builder().offline(true).build());` },
];

const facts = [
  ["MIT licensed", "Use it in anything; the source is on GitHub."],
  ["No accounts, no keys", "Nothing to sign up for. Price catalogs are public files."],
  ["No telemetry", "The library never reports anything about you or your agents."],
  ["Pre-launch", "Build from source today; nothing is on a package registry yet."],
];
---

<SiteLayout
  title="Skopli: read what your coding agents cost, from the logs on your disk"
  description="An MIT-licensed SDK that reads the session logs of 40 coding agents, rolls the usage up and prices it against public model catalogs. Nine languages, no accounts, no telemetry."
  locale={locale}
>
  <section class="hero">
    <h1>Read what your coding agents cost, from the logs already on your disk.</h1>
    <p class="lede">
      Skopli is an SDK. It reads the session files that 40 coding agents write locally, turns them into one event shape,
      rolls them up, and prices them against public model catalogs. Nine languages, one API, no accounts.
    </p>
    <p class="actions">
      <a class="btn btn-accent" href={repo} target="_blank" rel="noopener">View on GitHub</a>
      <a class="btn" href={`${docs}guide/getting-started/`}>Read the quickstart</a>
    </p>
  </section>

  <section class="panel output" aria-labelledby="output-title">
    <div class="panel-head">
      <h2 id="output-title">What <code>priceRollups</code> returns</h2>
      <p>By model, from the golden pricing fixture. The unknown model stays unpriced.</p>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Model</th>
            <th class="num">Input</th>
            <th class="num">Output</th>
            <th class="num">Cache read</th>
            <th class="num">USD</th>
            <th>Source</th>
            <th>Fetched</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr>
                <td data-label="Model"><code>{r.key}</code></td>
                <td class="num" data-label="Input">{num.format(r.tokens.input)}</td>
                <td class="num" data-label="Output">{num.format(r.tokens.output)}</td>
                <td class="num" data-label="Cache read">{num.format(r.tokens.cacheRead)}</td>
                {r.pricing.priced ? (
                  <>
                    <td class="num" data-label="USD">{usd(r.pricing.usd)}</td>
                    <td data-label="Source">{r.pricing.source}</td>
                    <td data-label="Fetched">{r.pricing.fetchedAt.slice(0, 10)}</td>
                  </>
                ) : (
                  <>
                    <td class="num nodata" data-label="USD">unpriced</td>
                    <td class="miss" colspan="2" data-label="Pricing">
                      <span>
                        <code>priced: false</code>, attempted <code>{r.pricing.attempted.join(", ")}</code>
                      </span>
                    </td>
                  </>
                )}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="caption">
      Rows from <code>golden/pricing/basic/expected-priced-rollup.json</code>, the fixture the SDK's own tests assert against. Catalogs are
      pinned at 2026-08-01 in that fixture; your run shows the fetch time of your cache.
    </p>
  </section>

  <section class="layers" aria-labelledby="layers-title">
    <h2 id="layers-title">Three layers, one shape</h2>
    <div class="grid">
      {
        layers.map((l, i) => (
          <article class="panel layer">
            <p class="step">{i + 1}</p>
            <h3>{l.name}</h3>
            <p class="net">{l.network}</p>
            <p>{l.text}</p>
            <a href={docs + l.docs}>{l.name} in the docs</a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="quick" aria-labelledby="quick-title">
    <div class="section-head">
      <h2 id="quick-title">The same four calls in nine languages</h2>
      <p>Detect, read, roll up, price. Pick your language once; the docs remember it.</p>
    </div>
    <LangSwitch locale={locale} />
    <div class="code-tabs" data-tab="quickstart">
      {
        languages.map((l) => (
          <div class="code-tab" data-lang={l.id}>
            <p class="install"><code>{l.install}</code></p>
            <Code code={l.quickstart} lang={l.shiki as BundledLanguage} themes={codeThemes} defaultColor={false} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="offline" aria-labelledby="offline-title">
    <div class="section-head">
      <h2 id="offline-title">Pricing without a network</h2>
      <p>
        Read and Rollup never make a request. Price fetches three public catalogs the first time you use it and
        caches them; from then on it can run from the cache alone, or from a table you supply with no sources at all.
      </p>
    </div>
    <div class="code-tabs" data-tab="offline">
      {
        offline.map((o) => (
          <div class="code-tab" data-lang={o.id}>
            <Code code={o.code} lang={o.shiki as BundledLanguage} themes={codeThemes} defaultColor={false} />
          </div>
        ))
      }
    </div>
  </section>

  <section class="harnesses" aria-labelledby="harness-title">
    <div class="section-head">
      <h2 id="harness-title">{harnesses.length} agents, read from their own log formats</h2>
      <p>Ids are stable; names follow each product's own branding. Each one has a golden fixture in the repository.</p>
    </div>
    <ul class="wall">
      {
        harnesses.map((h) => (
          <li>
            <span>{h.name}</span>
            <code>{h.id}</code>
          </li>
        ))
      }
    </ul>
    <p class="caption">
      Detected but not read, because they keep no reliable local token data: {unsupported.join(", ")}.
      Full list with the fields each one fills in: <a href={`${docs}reference/harnesses/`}>harness reference</a>.
    </p>
  </section>

  <section class="facts" aria-labelledby="facts-title">
    <h2 id="facts-title">What you are not signing up for</h2>
    <dl>
      {
        facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
    <p class="actions">
      <a class="btn btn-accent" href={repo} target="_blank" rel="noopener">{t(locale, "nav.github")}</a>
      <a class="btn" href={docs}>{t(locale, "footer.docs")}</a>
    </p>
  </section>
</SiteLayout>

<style>
  section {
    padding: var(--space-8) 0;
  }
  .hero {
    padding-top: var(--space-9);
    max-width: 52rem;
  }
  .hero h1 {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
  }
  .lede {
    font-size: var(--text-lg);
    color: var(--fg-muted);
    max-width: var(--measure);
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
  }
  .section-head {
    max-width: var(--measure);
    margin-bottom: var(--space-5);
  }
  .section-head p,
  .panel-head p {
    color: var(--fg-muted);
    margin: var(--space-2) 0 0;
  }
  h2 {
    font-size: var(--text-2xl);
    margin: 0;
  }
  .output {
    padding: var(--space-5);
  }
  .panel-head {
    margin-bottom: var(--space-4);
  }
  .table-scroll {
    position: relative;
    overflow-x: auto;
  }
  .output table {
    width: 100%;
    font-size: var(--text-sm);
  }
  .output td,
  .output th {
    white-space: nowrap;
  }
  .output .miss {
    white-space: normal;
    min-width: 14rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }
  .layer {
    padding: var(--space-5);
  }
  .layer h3 {
    margin: 0;
    font-size: var(--text-xl);
  }
  .step {
    font-family: var(--font-mono);
    color: var(--accent);
    margin: 0 0 var(--space-2);
  }
  .net {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--fg-muted);
    margin: var(--space-1) 0 var(--space-3);
  }
  .layer p:not(.step):not(.net) {
    margin: 0 0 var(--space-3);
    color: var(--fg-muted);
  }
  .quick .code-tabs {
    margin-top: var(--space-3);
  }
  .install {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    border: var(--rule) solid var(--rule-color);
    border-bottom: 0;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--surface);
  }
  .install + :global(pre) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }
  .wall {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: var(--space-2);
  }
  .wall li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3);
    background: var(--surface);
    border: var(--rule) solid var(--rule-color);
    border-radius: var(--radius);
    font-size: var(--text-sm);
  }
  .wall code {
    font-size: var(--text-xs);
    color: var(--fg-muted);
    background: none;
    padding: 0;
  }
  .facts dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
  }
  .facts dt {
    font-family: var(--font-display);
    font-weight: 600;
  }
  .facts dd {
    margin: var(--space-1) 0 0;
    color: var(--fg-muted);
  }
  @media (max-width: 767px) {
    .hero h1 {
      font-size: var(--text-3xl);
    }
    section {
      padding: var(--space-7) 0;
    }
  }
  @media (max-width: 900px) {
    .output thead {
      display: none;
    }
    .output tr,
    .output td {
      display: block;
      white-space: normal;
      text-align: left;
    }
    .output tr {
      padding: var(--space-2) 0;
      border-bottom: var(--rule) solid var(--rule-color);
    }
    .output td {
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
      border: 0;
      padding: 2px 0;
    }
    .output td::before {
      content: attr(data-label);
      color: var(--fg-muted);
      font-size: var(--text-xs);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .output .miss {
      min-width: 0;
    }
    .output .miss span {
      text-align: right;
    }
  }
</style>
