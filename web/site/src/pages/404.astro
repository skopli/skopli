---
import Button from "@skopli/ui/components/Button.astro";
import Footer from "@skopli/ui/components/Footer.astro";
import Header from "@skopli/ui/components/Header.astro";
import SkipLink from "@skopli/ui/components/SkipLink.astro";
import { copyFor } from "../copy.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { href, t } from "../lib/i18n.ts";
import { docsUrl, licenseUrl, privacyUrl, repoUrl } from "../site.ts";

const locale = "en";
const copy = copyFor(locale);
const tr = t(locale);
---

<BaseLayout
  locale={locale}
  title={copy.notFound.documentTitle}
  description={copy.notFound.body}
  path="/404"
  noindex
>
  <SkipLink t={tr} />
  <Header t={tr} homeHref={href("/", locale)} githubUrl={repoUrl}>
    <a slot="nav" href={docsUrl}>{tr("docs")}</a>
  </Header>
  <main id="main" tabindex="-1" class="not-found">
    <p class="not-found__code tabular">404</p>
    <h1>{copy.notFound.title}</h1>
    <p>{copy.notFound.body}</p>
    <p class="not-found__actions">
      <Button href={href("/", locale)} variant="primary">{copy.notFound.home}</Button>
      <Button href={docsUrl}>{copy.notFound.docs}</Button>
    </p>
  </main>
  <Footer t={tr} licenseHref={licenseUrl} privacyHref={privacyUrl}>
    <a href={docsUrl}>{copy.footer.docs}</a>
    <a href={repoUrl}>{copy.footer.github}</a>
  </Footer>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--page-max);
    min-height: calc(100vh - var(--header-h) - 12rem);
    margin: 0 auto;
    padding: var(--s-9) var(--s-5);
  }
  .not-found:focus {
    outline: none;
  }
  .not-found__code {
    margin: 0 0 var(--s-3);
    color: var(--ink-3);
    font-size: var(--fs-sm);
    letter-spacing: var(--tracking-caps);
  }
  h1 {
    margin: 0 0 var(--s-4);
    font-size: var(--fs-h1);
  }
  p {
    max-width: var(--content-width);
    color: var(--ink-1);
  }
  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    max-width: none;
    margin: var(--s-5) 0 0;
  }
  @media (max-width: 47.99rem) {
    .not-found {
      padding: var(--s-7) var(--s-4);
    }
  }
</style>
