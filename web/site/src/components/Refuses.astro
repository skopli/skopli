---
import type { Copy } from "../copy.ts";
import InlineCode from "./InlineCode.astro";

interface Props {
  copy: Copy["refuses"];
}

const { copy } = Astro.props;
---

<dl class="refuses">
  {
    copy.items.map((item) => (
      <div class="refuse">
        <dt>{item.title}</dt>
        <dd>
          <InlineCode text={item.body} />
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .refuses {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
    margin: 0;
  }
  .refuse {
    display: grid;
    gap: var(--s-3);
    padding: var(--s-5);
    border: var(--hair) solid var(--rule-1);
    border-radius: var(--r-3);
    background: var(--ground-1);
  }
  dt {
    font-size: var(--fs-h3);
    font-weight: var(--fw-heading);
  }
  dd {
    margin: 0;
    color: var(--ink-1);
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
  }
  @media (max-width: 63.99rem) {
    .refuses {
      grid-template-columns: 1fr;
    }
  }
</style>
