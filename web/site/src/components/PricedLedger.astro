---
import { useTranslations, type Locale } from "@skopli/ui/i18n";
import fixture from "../../../../golden/pricing/basic/expected-priced-rollup.json";

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const n = new Intl.NumberFormat("en-US");
const usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
const rows = fixture.rollups.map((r) => ({
  model: r.key,
  input: r.tokens.input,
  output: r.tokens.output,
  cacheRead: r.tokens.cacheRead,
  cacheWrite: r.tokens.cacheWrite + (r.tokens.cacheWrite1h ?? 0),
  pricing: r.pricing,
}));
const hits = rows.filter((r) => r.pricing.priced);
const total = hits.reduce((sum, r) => sum + (r.pricing.usd ?? 0), 0);
const date = hits[0]?.pricing.fetchedAt?.slice(0, 10) ?? "";
const cols = ["input", "output", "cacheRead", "cacheWrite"] as const;
---

<figure class="priced">
  <div class="table-wrap">
    <table>
      <caption class="visually-hidden">{t("home.ledger.caption")}</caption>
      <thead>
        <tr>
          <th scope="col">{t("home.ledger.col.model")}</th>
          {cols.map((c) => <th scope="col">{t(`home.ledger.col.${c}`)}</th>)}
          <th scope="col">{t("home.ledger.col.usd")}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r, i) => (
            <tr style={`--i: ${i}`}>
              <th scope="row">{r.model}</th>
              {cols.map((c) => (
                <td data-label={t(`home.ledger.col.${c}`)}>{n.format(r[c])}</td>
              ))}
              {r.pricing.priced ? (
                <td data-label={t("home.ledger.col.usd")}>
                  {usd.format(r.pricing.usd ?? 0)}
                  <small>{r.pricing.source}</small>
                </td>
              ) : (
                <td data-label={t("home.ledger.col.usd")} class="miss">
                  {t("home.ledger.miss")}
                  <small>{t("home.ledger.tried", { keys: (r.pricing.attempted ?? []).join(", ") })}</small>
                </td>
              )}
            </tr>
          ))
        }
      </tbody>
      <tfoot>
        <tr style={`--i: ${rows.length}`}>
          <th scope="row">{t("home.ledger.total")}</th>
          <td colspan={cols.length} class="total-note">
            {t("home.ledger.totalNote", { priced: hits.length, missed: rows.length - hits.length })}
          </td>
          <td data-label={t("home.ledger.col.usd")}>{usd.format(total)}</td>
        </tr>
      </tfoot>
    </table>
  </div>
  <figcaption>{t("home.ledger.note", { date })}</figcaption>
</figure>

<style>
  .priced {
    margin: 0;
    min-width: 0;
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
  }

  th,
  td {
    padding: var(--space-3) var(--space-2);
    text-align: right;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }

  th[scope="col"] {
    font: 600 var(--text-xs) / 1.4 var(--font-sans);
    color: var(--fg-muted);
    white-space: nowrap;
  }

  th[scope="row"],
  th:first-child {
    text-align: left;
    font-family: var(--font-mono);
    font-weight: 400;
    word-break: break-all;
  }

  tfoot th[scope="row"] {
    font-family: var(--font-sans);
    font-weight: 600;
  }

  td small {
    display: block;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    font-family: var(--font-sans);
    overflow-wrap: anywhere;
  }

  .miss {
    color: var(--miss);
    font-family: var(--font-mono);
  }

  .total-note {
    text-align: left;
    color: var(--fg-muted);
  }

  tfoot td:last-child {
    font-weight: 600;
    font-size: var(--text-md);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  @media (max-width: 47.9rem) {
    thead {
      display: none;
    }

    tr {
      display: grid;
      padding-block: var(--space-3);
      border-bottom: 1px solid var(--rule);
    }

    th,
    td {
      display: flex;
      justify-content: space-between;
      gap: var(--space-3);
      padding: var(--space-1) 0;
      border: 0;
      text-align: right;
    }

    th[scope="row"] {
      padding-bottom: var(--space-2);
    }

    td::before {
      content: attr(data-label);
      color: var(--fg-muted);
      font-family: var(--font-sans);
    }

    td small {
      flex-basis: 100%;
    }

    .total-note {
      display: block;
      text-align: left;
    }

    .total-note::before {
      content: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    tbody tr,
    tfoot tr {
      animation: tally 420ms var(--ease-out) both;
      animation-delay: calc(80ms + var(--i) * 70ms);
    }

    @keyframes tally {
      from {
        opacity: 0;
        translate: 0 0.4rem;
      }
    }
  }
</style>
