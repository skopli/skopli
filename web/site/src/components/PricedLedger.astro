---
import T from "@skopli/ui/components/T.astro";
import { useTranslations, type Locale } from "@skopli/ui/i18n";
import fixture from "../../../../golden/pricing/basic/expected-priced-rollup.json";

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const n = new Intl.NumberFormat("en-US");
const usd = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
const rows = fixture.rollups.map((r) => ({
  model: r.key,
  input: r.tokens.input,
  output: r.tokens.output,
  cacheRead: r.tokens.cacheRead,
  cacheWrite: r.tokens.cacheWrite + (r.tokens.cacheWrite1h ?? 0),
  pricing: r.pricing,
}));
const hits = rows.filter((r) => r.pricing.priced);
const total = hits.reduce((sum, r) => sum + (r.pricing.usd ?? 0), 0);
const date = hits[0]?.pricing.fetchedAt?.slice(0, 10);
if (!date) throw new Error("pricing fixture has no fetchedAt");
const cols = ["input", "output", "cacheRead", "cacheWrite"] as const;
---

<figure class="priced">
  <table class="stack-table">
    <caption><T k="home.ledger.caption" /></caption>
    <thead>
      <tr>
        <th scope="col">{t("home.ledger.col.model")}</th>
        {cols.map((c) => (
          <th scope="col" class="num">
            {t(`home.ledger.col.${c}`)}
          </th>
        ))}
        <th scope="col" class="num">{t("home.ledger.col.usd")}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r, i) => (
          <tr style={`--i: ${i}`}>
            <th scope="row">{r.model}</th>
            {cols.map((c) => (
              <td class="num" data-label={t(`home.ledger.col.${c}`)} data-zero={r[c] === 0 || undefined}>
                {n.format(r[c])}
              </td>
            ))}
            <td class="num" data-label={t("home.ledger.col.usd")}>
              {r.pricing.priced ? (
                <>
                  <span>{usd.format(r.pricing.usd ?? 0)}</span>
                  <small>{r.pricing.source}</small>
                </>
              ) : (
                <>
                  <code class="miss">{t("home.ledger.miss")}</code>
                  <small>{t("home.ledger.tried", { keys: (r.pricing.attempted ?? []).join(", ") })}</small>
                </>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
    <tfoot>
      <tr style={`--i: ${rows.length}`}>
        <th scope="row">{t("home.ledger.total")}</th>
        <td colspan={cols.length} class="total-note">
          {t("home.ledger.totalNote", { priced: hits.length, missed: rows.length - hits.length })}
        </td>
        <td class="num" data-label={t("home.ledger.col.usd")}>
          {usd.format(total)}
        </td>
      </tr>
    </tfoot>
  </table>
  <figcaption>{t("home.ledger.note", { date })}</figcaption>
</figure>

<style>
  .priced {
    margin: 0;
    min-width: 0;
    font-size: var(--text-sm);
  }

  caption {
    padding-bottom: var(--space-2);
    text-align: left;
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  tbody th {
    font-family: var(--font-mono);
    font-weight: 400;
    min-width: 14rem;
    overflow-wrap: anywhere;
  }

  tfoot th {
    font-weight: 600;
  }

  td small {
    display: block;
    font-size: var(--text-xs);
    color: var(--fg-muted);
    overflow-wrap: anywhere;
  }

  @media (max-width: 47.9rem) {
    .priced .num {
      text-align: left;
    }

    .priced td[data-zero] {
      display: none;
    }
  }

  .miss {
    color: var(--miss);
    white-space: nowrap;
  }

  .total-note {
    text-align: left;
    color: var(--fg-muted);
  }

  td:last-child {
    min-width: 10rem;
  }

  tfoot td:last-child {
    font-weight: 600;
    font-size: var(--text-md);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  @media (max-width: 47.9rem) {
    tbody th {
      min-width: 0;
      padding-bottom: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    tbody tr,
    tfoot tr {
      animation: tally 420ms var(--ease-out) both;
      animation-delay: calc(80ms + var(--i) * 70ms);
    }

    @keyframes tally {
      from {
        opacity: 0;
        translate: 0 0.4rem;
      }
    }
  }
</style>
