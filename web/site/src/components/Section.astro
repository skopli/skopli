---
import InlineCode from "./InlineCode.astro";

interface Props {
  id: string;
  title: string;
  body?: string;
}

const { id, title, body } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <div class="section__in">
    <div class="section__head">
      <h2 id={`${id}-title`}>{title}</h2>
      {
        body && (
          <p class="section__body">
            <InlineCode text={body} />
          </p>
        )
      }
    </div>
    <slot />
  </div>
</section>

<style>
  .section {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--s-5);
  }
  .section__in {
    padding: var(--s-8) 0;
    border-top: var(--hair) solid var(--rule-1);
  }
  .section__head {
    max-width: var(--content-width);
    margin-bottom: var(--s-6);
  }
  .section__head h2 {
    margin: 0 0 var(--s-3);
    font-size: var(--fs-h1);
    line-height: var(--lh-tight);
  }
  .section__body {
    overflow-wrap: anywhere;
    margin: 0;
    color: var(--ink-1);
    font-size: var(--fs-body);
  }
  @media (max-width: 47.99rem) {
    .section {
      padding: 0 var(--s-4);
    }
    .section__in {
      padding: var(--s-7) 0;
    }
  }
</style>
