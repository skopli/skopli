---
import HarnessIcon from "@skopli/ui/components/HarnessIcon.astro";
import { harnesses } from "@skopli/ui/data/harnesses.ts";
import type { Copy } from "../copy.ts";
import { docsUrl } from "../site.ts";

interface Props {
  copy: Copy["harnesses"];
}

const { copy } = Astro.props;
---

<ul class="harnesses">
  {
    harnesses.map((h) => (
      <li data-harness={h.id}>
        <span class="harnesses__name">
          <span class="harnesses__icon"><HarnessIcon slug={h.icon} /></span>
          {h.name}
        </span>
        <code>{h.id}</code>
      </li>
    ))
  }
</ul>
<p class="harnesses__more">
  <a href={`${docsUrl}reference/harnesses`}>{copy.more}</a>
</p>

<style>
  .harnesses {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0 var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .harnesses li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: var(--target);
    border-bottom: var(--hair) solid var(--rule-1);
    font-size: var(--fs-sm);
  }
  .harnesses__name {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
  }
  .harnesses__icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    color: var(--ink-2);
  }
  .harnesses__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .harnesses code {
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }
  .harnesses__more {
    margin: var(--s-5) 0 0;
    font-size: var(--fs-sm);
  }
  .harnesses__more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }
  @media (max-width: 47.99rem) {
    .harnesses {
      grid-template-columns: 1fr 1fr;
      gap: 0 var(--s-4);
    }
    .harnesses__icon,
    .harnesses code {
      display: none;
    }
  }
</style>
