---
import { int, rateDate, rows, totals, usd } from "../data/example.ts";
import type { Copy } from "../copy.ts";
import { format } from "@skopli/ui/i18n";
import InlineCode from "./InlineCode.astro";

interface Props {
  copy: Copy["ledger"];
}

const { copy } = Astro.props;
---

<figure class="ledger">
  <div class="ledger__head">
    <code>{copy.frameTitle}</code>
    <span>{format(copy.rates, { date: rateDate })}</span>
  </div>
  <div class="table-frame">
    <div class="table-scroll" tabindex="0">
      <table>
        <caption class="visually-hidden"><InlineCode text={copy.caption} /></caption>
        <thead>
          <tr>
            <th scope="col">{copy.model}</th>
            <th scope="col" class="num ledger__wide">{copy.input}</th>
            <th scope="col" class="num ledger__wide">{copy.cacheRead}</th>
            <th scope="col" class="num ledger__wide">{copy.cacheWrite}</th>
            <th scope="col" class="num ledger__wide">{copy.output}</th>
            <th scope="col" class="num">{copy.usd}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class:list={{ "ledger__miss-row": !row.pricing.priced }}>
                <td>
                  <code class="ledger__model">{row.model}</code>
                  {!row.pricing.priced && (
                    <span class="ledger__attempted">
                      {format(copy.attempted, { keys: row.pricing.attempted.join(", ") })}
                    </span>
                  )}
                </td>
                <td class="num ledger__wide">{int(row.tokens.input)}</td>
                <td class="num ledger__wide">{int(row.tokens.cacheRead)}</td>
                <td class="num ledger__wide">{int(row.tokens.cacheWrite)}</td>
                <td class="num ledger__wide">{int(row.tokens.output)}</td>
                <td class="num">
                  {row.pricing.priced ? (
                    <span class="ledger__priced">{usd(row.pricing.usd)}</span>
                  ) : (
                    <code class="ledger__miss">priced: false</code>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <td>{format(copy.footer, { priced: totals.priced, misses: totals.misses })}</td>
            <td class="num ledger__wide">{int(totals.input)}</td>
            <td class="num ledger__wide">{int(totals.cacheRead)}</td>
            <td class="num ledger__wide">{int(totals.cacheWrite)}</td>
            <td class="num ledger__wide">{int(totals.output)}</td>
            <td class="num">{usd(totals.usd)}</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <figcaption class="ledger__note">
    <InlineCode text={copy.note} />
  </figcaption>
</figure>

<style>
  .ledger {
    margin: var(--s-7) 0 0;
  }
  .ledger__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-1) var(--s-4);
    padding: var(--s-2) var(--s-4);
    border: var(--hair) solid var(--rule-1);
    border-bottom: 0;
    border-radius: var(--r-2) var(--r-2) 0 0;
    background: var(--code-title-bg);
    color: var(--code-title-fg);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .ledger__head span {
    white-space: nowrap;
  }
  .ledger__head code {
    font-size: var(--fs-sm);
    letter-spacing: 0;
    text-transform: none;
  }
  .ledger .table-frame {
    max-width: none;
    border-radius: 0 0 var(--r-2) var(--r-2);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--hair) solid var(--rule-1);
    text-align: left;
    white-space: nowrap;
  }
  th {
    color: var(--ink-2);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .num {
    text-align: right;
  }
  tfoot td {
    border-top: var(--hair) solid var(--rule-2);
    border-bottom: 0;
    color: var(--ink-0);
    font-weight: 600;
  }
  tfoot td:first-child {
    color: var(--ink-2);
    font-weight: 500;
  }
  .ledger__model {
    font-size: var(--fs-sm);
  }
  .ledger__attempted {
    display: block;
    margin-top: var(--s-1);
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }
  .ledger__priced {
    color: var(--ok);
  }
  .ledger__miss {
    color: var(--miss);
    font-size: var(--fs-sm);
  }
  .ledger__miss-row td {
    color: var(--ink-2);
  }
  .ledger__note {
    max-width: var(--content-width-wide);
    margin: var(--s-3) 0 0;
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  @media (max-width: 63.99rem) {
    th,
    td {
      padding-inline: var(--s-3);
    }
  }
  @media (max-width: 47.99rem) {
    .ledger__wide {
      display: none;
    }
  }
</style>
