---
import "@skopli/ui/styles/base.css";
import "@skopli/ui/styles/prose.css";
import "@skopli/ui/styles/code-tabs.css";
import { posthogSnippet } from "@skopli/ui/analytics.ts";
import { bootScript } from "@skopli/ui/head.ts";
import { t, type Locale } from "@skopli/ui/i18n/index.ts";
import Handoffs from "@skopli/ui/components/Handoffs.astro";
import LangSwitch from "@skopli/ui/components/LangSwitch.astro";
import Mark from "@skopli/ui/components/Mark.astro";
import SiteFooter from "@skopli/ui/components/SiteFooter.astro";
import ThemeToggle from "@skopli/ui/components/ThemeToggle.astro";
import Search from "../components/Search.astro";
import { mdPathFor, order, pathFor, sections } from "../nav.ts";

interface Props {
  title: string;
  description: string;
  id?: string;
  titles?: Record<string, string>;
  headings?: { depth: number; slug: string; text: string }[];
}
const locale: Locale = "en";
const { title, description, id, titles = {}, headings = [] } = Astro.props;
const canonical = id ? new URL(pathFor(id), Astro.site).href : undefined;
const canonicalMdUrl = id ? new URL(mdPathFor(id), Astro.site).href : undefined;
const index = id ? order.indexOf(id) : -1;
const prev = index > 0 ? order[index - 1] : undefined;
const next = index >= 0 ? order[index + 1] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{id === "index" ? "Skopli docs" : `${title} - Skopli docs`}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonicalMdUrl && <link rel="alternate" type="text/markdown" href={canonicalMdUrl} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <script is:inline set:html={bootScript} />
    <script is:inline set:html={posthogSnippet} />
  </head>
  <body>
    <a class="skip-link" href="#content">{t(locale, "nav.skip")}</a>
    <header class="masthead">
      <a class="brand" href="/skopli/"><Mark size={22} /><span>{t(locale, "site.name")}</span><span class="brand-sub">docs</span></a>
      <Search locale={locale} />
      <nav class="masthead-nav" aria-label="Site">
        <a href="https://skopli.com/">{t(locale, "footer.site")}</a>
        <a href="https://github.com/skopli/skopli" target="_blank" rel="noopener">{t(locale, "nav.github")}</a>
        <ThemeToggle locale={locale} />
      </nav>
    </header>
    <div class="frame">
      <aside class="rail">
        <details class="drawer">
          <summary>{t(locale, "nav.menu")}</summary>
          <nav aria-label="Documentation">
          {
            sections.map((s) => (
              <section class="rail-section">
                <h2>{s.title}</h2>
                <ul>
                  {s.pages.map((p) => (
                    <li>
                      <a href={pathFor(p)} aria-current={p === id ? "page" : undefined} data-pagefind-ignore>
                        {titles[p] ?? p}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </nav>
        </details>
      </aside>
      <main id="content" class="column" data-pagefind-body>
        <header class="page-head">
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <LangSwitch locale={locale} compact />
        </header>
        <article class="prose">
          <slot />
        </article>
        {
          index >= 0 && (
            <nav class="pager" aria-label="Pages" data-pagefind-ignore>
              {prev ? (
                <a href={pathFor(prev)} rel="prev">
                  <span>{t(locale, "nav.previous")}</span>
                  {titles[prev]}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a href={pathFor(next)} rel="next" class="next">
                  <span>{t(locale, "nav.next")}</span>
                  {titles[next]}
                </a>
              )}
            </nav>
          )
        }
      </main>
      <aside class="margin" data-pagefind-ignore>
        {
          toc.length > 0 && (
            <nav class="toc" aria-labelledby="toc-title">
              <h2 id="toc-title">{t(locale, "toc.title")}</h2>
              <ol>
                {toc.map((h) => (
                  <li class={`depth-${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {canonicalMdUrl && <Handoffs canonicalMdUrl={canonicalMdUrl} locale={locale} />}
      </aside>
    </div>
    <div class="foot"><SiteFooter locale={locale} /></div>
  </body>
</html>

<style>
  .masthead {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    padding: 0 var(--space-5);
    border-bottom: var(--rule-heavy) solid var(--rule-strong);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-lg);
    color: var(--fg);
    text-decoration: none;
  }
  .brand-sub {
    color: var(--fg-muted);
    font-weight: 400;
  }
  .masthead-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }
  .masthead-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-2);
    font-family: var(--font-display);
    color: var(--fg-muted);
    text-decoration: none;
  }
  .masthead-nav a:hover {
    color: var(--fg);
  }
  .frame {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 15rem;
    gap: var(--space-7);
    max-width: 90rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-8);
  }
  .rail h2,
  .toc h2 {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: var(--space-2);
  }
  .rail-section + .rail-section {
    margin-top: var(--space-5);
  }
  .rail ul,
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-sm);
  }
  .rail a,
  .toc a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border-left: var(--rule) solid var(--rule-color);
    color: var(--fg-muted);
    text-decoration: none;
  }
  .rail a:hover,
  .toc a:hover {
    color: var(--fg);
  }
  .rail a[aria-current="page"] {
    color: var(--fg);
    border-left: var(--rule-heavy) solid var(--accent);
    padding-left: calc(var(--space-3) - 1px);
  }
  .toc .depth-3 a {
    padding-left: var(--space-5);
  }
  .margin {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .rail nav,
  .margin {
    position: sticky;
    top: var(--space-5);
    max-height: calc(100dvh - var(--space-6));
    overflow-y: auto;
  }
  .page-head {
    margin-bottom: var(--space-5);
  }
  .lede {
    max-width: var(--measure);
    margin: var(--space-3) 0 var(--space-4);
    font-size: var(--text-lg);
    color: var(--fg-muted);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: var(--rule-heavy) solid var(--rule-strong);
    font-family: var(--font-display);
  }
  .pager a {
    display: grid;
    gap: var(--space-1);
    min-height: var(--target);
    text-decoration: none;
    color: var(--fg);
  }
  .pager a span {
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .pager .next {
    text-align: right;
  }
  .foot {
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }
  @media (max-width: 1100px) {
    .frame {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
    .margin {
      grid-column: 2;
      position: static;
      max-height: none;
    }
  }
  .drawer > summary {
    display: none;
  }
  @media (max-width: 760px) {
    .drawer > summary {
      display: flex;
      align-items: center;
      min-height: var(--target);
      padding: 0 var(--space-3);
      border: var(--rule) solid var(--rule-color);
      border-radius: var(--radius);
      cursor: pointer;
      font-family: var(--font-display);
      font-weight: 600;
      list-style: none;
    }
    .drawer > summary::-webkit-details-marker {
      display: none;
    }
    .drawer > summary::after {
      content: "+";
      margin-left: auto;
    }
    .drawer[open] > summary::after {
      content: "-";
    }
    .drawer[open] > summary {
      margin-bottom: var(--space-4);
    }
    .masthead {
      flex-wrap: wrap;
      padding: var(--space-2) var(--space-4);
    }
    .frame {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      padding: var(--space-5) var(--space-4) var(--space-7);
    }
    .rail nav {
      position: static;
      max-height: none;
    }
    .rail ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
    }
    .rail a {
      border-left: 0;
      border-bottom: var(--rule-heavy) solid transparent;
      padding: 0 var(--space-2);
    }
    .rail a[aria-current="page"] {
      border-left: 0;
      border-bottom-color: var(--accent);
      padding-left: var(--space-2);
    }
    .margin {
      grid-column: 1;
    }
    .foot {
      padding: 0 var(--space-4);
    }
  }
</style>

<script>
  const drawer = document.querySelector<HTMLDetailsElement>(".drawer");
  const wide = matchMedia("(min-width: 761px)");
  const sync = () => drawer && (drawer.open = wide.matches);
  sync();
  wide.addEventListener("change", sync);
</script>
