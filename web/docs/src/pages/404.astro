---
import Button from "@skopli/ui/components/Button.astro";
import { defaultLocale } from "@skopli/ui/i18n";
import DocsLayout from "../layouts/DocsLayout.astro";
import { href, t as translate } from "../lib/i18n.ts";

const t = translate(defaultLocale);
const [before, after] = t("notFoundBody", { path: "\u0000" }).split("\u0000");
---

<DocsLayout locale={defaultLocale} slug="404" title={t("notFoundTitle")} description="" noindex>
  <p>
    {before}<code data-not-found-path></code>{after}
  </p>
  <p><Button href={href("/")} variant="primary">{t("backToDocs")}</Button></p>
</DocsLayout>

<script>
  const path = document.querySelector<HTMLElement>("[data-not-found-path]");
  if (path) path.textContent = location.pathname;
</script>
