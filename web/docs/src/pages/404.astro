---
import Button from "@skopli/ui/components/Button.astro";
import { defaultLocale } from "@skopli/ui/i18n";
import DocsLayout from "../layouts/DocsLayout.astro";
import { href, t as translate } from "../lib/i18n.ts";

const t = translate(defaultLocale);
const parts = t("notFoundBody", { path: "\u0000" }).split("\u0000");
---

<DocsLayout locale={defaultLocale} slug="404" title={t("notFoundTitle")} description="" noindex>
  <p>
    {parts.map((part, i) => (
      <>
        {i > 0 && <code data-not-found-path></code>}
        {part}
      </>
    ))}
  </p>
  <p><Button href={href("/")} variant="primary">{t("backToDocs")}</Button></p>
</DocsLayout>

<script>
  const { pathname, search, hash } = location;
  const home = document.documentElement.dataset.home;
  if (pathname.endsWith("/") && pathname !== home)
    location.replace(pathname.replace(/\/+$/, "") + search + hash);
  else
    for (const el of document.querySelectorAll("[data-not-found-path]")) el.textContent = pathname;
</script>
