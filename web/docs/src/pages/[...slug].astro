---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { allDocs, docPath, mdPath, routeSlug, splitId, type Doc } from "../lib/pages.ts";
import { locales } from "../lib/i18n.ts";
import { localizePath } from "@skopli/ui/i18n";

export const getStaticPaths = (async () => {
  const docs = await allDocs();
  return docs.map((entry) => {
    const { locale, slug } = splitId(entry.id);
    const alternates = locales.filter((l) => docs.some((d) => d.id === `${l}/${slug}`.replace(/\/$/, "")));
    return { params: { slug: routeSlug(locale, slug) }, props: { entry, alternates } };
  });
}) satisfies GetStaticPaths;

const { entry, alternates } = Astro.props as { entry: Doc; alternates: typeof locales };
const { locale, slug } = splitId(entry.id);
const { Content, headings } = await render(entry);
---

<DocsLayout
  {locale}
  {slug}
  title={entry.data.title}
  description={entry.data.description}
  {headings}
  {alternates}
  mdPath={localizePath(mdPath(slug), locale)}
  data-path={docPath(slug)}
>
  <Content />
</DocsLayout>
