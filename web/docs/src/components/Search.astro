---
import Icon from "@skopli/ui/components/Icon.astro";
import { useTranslations, type Locale } from "@skopli/ui/i18n";

interface Props {
  locale: Locale;
  base: string;
}

const { locale, base } = Astro.props;
const t = useTranslations(locale);
---

<button class="search-open btn" type="button" data-search-open aria-label={t("search.label")}>
  <Icon name="search" size={16} />
  <span class="search-text">{t("search.placeholder")}</span>
</button>
<dialog
  class="search"
  data-search
  data-base={base}
  data-empty={t("search.empty")}
  data-results-one={t("search.results.one")}
  data-results-other={t("search.results.other")}
  data-unavailable={t("search.unavailable")}
>
  <form method="dialog" class="search-form">
    <label class="visually-hidden" for="search-input">{t("search.label")}</label>
    <Icon name="search" size={18} />
    <input
      id="search-input"
      type="search"
      placeholder={t("search.placeholder")}
      autocomplete="off"
    />
    <button class="icon-btn" type="submit" aria-label={t("nav.close")}>
      <Icon name="close" size={18} />
    </button>
  </form>
  <p class="search-status" aria-live="polite"></p>
  <ol class="search-results"></ol>
</dialog>

<style>
  .search-open {
    gap: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .search-text {
    display: none;
  }

  @media (min-width: 768px) {
    .search-text {
      display: inline;
    }

    .search-open {
      min-width: 12rem;
      justify-content: flex-start;
    }
  }

  .search {
    width: min(100% - 2rem, 40rem);
    margin: 10vh auto;
    padding: 0;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
  }

  .search::backdrop {
    background: rgb(0 0 0 / 0.4);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline-start: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }

  input {
    flex: 1;
    min-height: 3.5rem;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    outline: 0;
  }

  .search-status {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .search-status:empty {
    display: none;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    max-height: 60vh;
    overflow-y: auto;
  }

  .search-results:empty {
    display: none;
  }

  .search-results a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3);
    color: var(--fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .search-results a:hover,
  .search-results a:focus-visible {
    background: var(--bg-raised);
  }

  .search-results strong {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--text-lg);
  }

  .search-results p {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .search-results :global(mark) {
    background: var(--selection);
    color: var(--fg);
  }
</style>

<script>
  type Result = { data(): Promise<{ url: string; excerpt: string; meta: { title?: string } }> };
  type Pagefind = {
    init(): Promise<void>;
    search(q: string): Promise<{ results: Result[] }>;
  };

  const dialog = document.querySelector<HTMLDialogElement>("[data-search]");
  const input = dialog?.querySelector("input");
  const status = dialog?.querySelector<HTMLElement>(".search-status");
  const list = dialog?.querySelector<HTMLOListElement>(".search-results");
  let pagefind: Pagefind | undefined;

  const load = async () => {
    if (pagefind) return pagefind;
    const url = `${dialog!.dataset.base}pagefind/pagefind.js`;
    pagefind = (await import(/* @vite-ignore */ url)) as Pagefind;
    await pagefind.init();
    return pagefind;
  };

  const open = () => {
    dialog?.showModal();
    input?.focus();
    void load().catch(() => (status!.textContent = dialog!.dataset.unavailable!));
  };

  document.querySelector("[data-search-open]")?.addEventListener("click", open);
  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && !dialog?.open && !(e.target instanceof HTMLInputElement)) {
      e.preventDefault();
      open();
    }
  });

  let timer: ReturnType<typeof setTimeout>;
  input?.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(async () => {
      const q = input.value.trim();
      list!.replaceChildren();
      if (!q) return (status!.textContent = "");
      const pf = await load().catch(() => undefined);
      if (!pf) return;
      const { results } = await pf.search(q);
      const data = await Promise.all(results.slice(0, 10).map((r) => r.data()));
      const ds = dialog!.dataset;
      const tpl = results.length === 1 ? ds.resultsOne! : ds.resultsOther!;
      status!.textContent = data.length
        ? tpl.replace("{count}", String(results.length))
        : dialog!.dataset.empty!.replace("{query}", q);
      for (const d of data) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = d.url;
        const title = document.createElement("strong");
        title.textContent = d.meta.title ?? d.url;
        const excerpt = document.createElement("p");
        excerpt.innerHTML = d.excerpt;
        a.append(title, excerpt);
        li.append(a);
        list!.append(li);
      }
    }, 120);
  });
</script>
