---
import Icon from "@skopli/ui/components/Icon.astro";
import { SITE, mdPath } from "../nav";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const md = mdPath(slug);
const absolute = `${SITE}${md}`;
const prompt = encodeURIComponent(`Read ${absolute} so I can ask questions about it.`);
const targets = [
  { name: "ChatGPT", icon: "chatgpt", href: `https://chatgpt.com/?q=${prompt}` },
  { name: "Claude", icon: "claude", href: `https://claude.ai/new?q=${prompt}` },
  { name: "Grok", icon: "grok", href: `https://grok.com/?q=${prompt}` },
  { name: "Perplexity", icon: "perplexity", href: `https://www.perplexity.ai/search?q=${prompt}` },
  { name: "Google AI Mode", icon: "google", href: `https://www.google.com/search?udm=50&q=${prompt}` },
  { name: "Cursor", icon: "cursor", href: `cursor://anysphere.cursor-deeplink/prompt?text=${prompt}` },
];
---

<div class="actions" data-actions data-md={md}>
  <button class="actions__btn" type="button" data-copy aria-live="polite">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="1.5" />
      <path d="M5 15V5.5A1.5 1.5 0 0 1 6.5 4H15" />
    </svg>
    <span data-copy-label>Copy page</span>
  </button>
  <a class="actions__btn actions__btn--md" href={md}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="M7 15V9l2.5 3L12 9v6M16 9v6M14 13l2 2 2-2" />
    </svg>
    View as Markdown
  </a>
  <details class="actions__menu">
    <summary class="actions__btn">Open in</summary>
    <ul>
      {targets.map(({ name, icon, href }) => (
        <li>
          <a href={href} rel="noopener"><Icon name={icon} />{name}</a>
        </li>
      ))}
    </ul>
  </details>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-actions]");
  const copy = root?.querySelector<HTMLButtonElement>("[data-copy]");
  const md = root?.dataset.md;
  if (root && copy && md) {
    copy.addEventListener("click", async () => {
      const text = await (await fetch(md)).text();
      await navigator.clipboard.writeText(text);
      const label = copy.querySelector("[data-copy-label]")!;
      label.textContent = "Copied";
      setTimeout(() => (label.textContent = "Copy page"), 1500);
    });
    document.addEventListener("click", (event) => {
      const menu = root.querySelector<HTMLDetailsElement>("details[open]");
      if (menu && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>
