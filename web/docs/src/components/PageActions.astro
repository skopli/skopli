---
import { aiTools, pageActionEvents } from "@skopli/ui/analytics";
import type { Translate } from "@skopli/ui/i18n";
import { aiPrompt } from "@skopli/ui/i18n";
import { basePath, siteOrigin } from "../site.ts";

interface Props {
  t: Translate;
  mdPath: string;
  placement: "rail" | "top";
}

const { t, mdPath, placement } = Astro.props;
const canonicalMdUrl = `${siteOrigin}${basePath}${mdPath}`;
const q = encodeURIComponent(aiPrompt(canonicalMdUrl));
const tools = aiTools.map((tool) => ({ ...tool, href: tool.url(q) }));
const uid = `page-actions-${placement}`;
---

<skopli-page-actions
  class:list={["page-actions", `page-actions--${placement}`]}
  data-md-url={`${basePath}${mdPath}`}
  data-copied={t("copied")}
  data-copy-failed={t("copyFailed")}
  data-pagefind-ignore
>
  <button
    type="button"
    class="page-actions__copy"
    data-copy-page
    data-event={pageActionEvents.copyMarkdown}
    data-event-on-success
    aria-label={t("copyPageLabel")}
  >
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="9" y="9" width="13" height="13" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <span data-copy-label>{t("copyPage")}</span>
  </button>
  <button
    type="button"
    class="page-actions__more"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={`${uid}-menu`}
    aria-label={t("morePageActions")}
  >
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>
  <div class="page-actions__menu" role="menu" id={`${uid}-menu`} hidden>
    <a role="menuitem" href={`${basePath}${mdPath}`} target="_blank" rel="noopener">
      {t("viewAsMarkdown")}
    </a>
    {
      tools.map((tool) => (
        <a role="menuitem" href={tool.href} target="_blank" rel="noopener" data-event={tool.event}>
          {t("openIn", { tool: tool.name })}
        </a>
      ))
    }
  </div>
</skopli-page-actions>

<style>
  .page-actions {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    border: var(--hair) solid var(--rule-2);
    border-radius: var(--r-2);
    background: var(--ground-1);
    font-size: var(--fs-sm);
  }
  .page-actions button {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: var(--target);
    padding: 0 var(--s-3);
    border: 0;
    background: none;
    color: var(--ink-1);
    cursor: pointer;
  }
  .page-actions button:hover {
    color: var(--ink-0);
    background: var(--ground-2);
  }
  .page-actions button:focus-visible {
    outline-offset: -2px;
  }
  .page-actions svg {
    flex-shrink: 0;
  }
  .page-actions__copy {
    border-radius: var(--r-2) 0 0 var(--r-2);
  }
  .page-actions__copy[data-state="copied"] {
    color: var(--ok);
  }
  .page-actions__copy[data-state="failed"] {
    color: var(--miss);
  }
  .page-actions .page-actions__more {
    border-inline-start: var(--hair) solid var(--rule-2);
    border-radius: 0 var(--r-2) var(--r-2) 0;
  }
  .page-actions__more[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .page-actions__menu {
    position: fixed;
    z-index: 30;
    display: grid;
    min-width: 14rem;
    padding: var(--s-1);
    overflow-y: auto;
    border: var(--hair) solid var(--rule-2);
    border-radius: var(--r-2);
    background: var(--ground-1);
  }
  .page-actions__menu[hidden] {
    display: none;
  }
  .page-actions__menu a {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--s-3);
    border-radius: var(--r-1);
    color: var(--ink-1);
    text-decoration: none;
  }
  .page-actions__menu a:hover,
  .page-actions__menu a:focus-visible {
    color: var(--ink-0);
    background: var(--ground-2);
  }
  .page-actions__menu a:focus-visible {
    outline-offset: -2px;
  }
  @media (pointer: coarse) {
    .page-actions button,
    .page-actions__menu a {
      min-height: var(--target);
    }
    .page-actions__more {
      min-width: var(--target);
    }
  }
</style>

<script>
  import { announce } from "@skopli/ui/markdown/copy-code.ts";

  class SkopliPageActions extends HTMLElement {
    close = () => {};
    place = () => {};

    connectedCallback() {
      const copy = this.querySelector<HTMLButtonElement>("[data-copy-page]")!;
      const label = copy.querySelector<HTMLElement>("[data-copy-label]")!;
      const idle = label.textContent ?? "";
      const more = this.querySelector<HTMLButtonElement>(".page-actions__more")!;
      const menu = this.querySelector<HTMLElement>(".page-actions__menu")!;
      const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>("a"));

      copy.addEventListener("click", async () => {
        try {
          const res = await fetch(this.dataset.mdUrl!);
          if (!res.ok) throw new Error(String(res.status));
          await navigator.clipboard.writeText(await res.text());
          copy.dataset.state = "copied";
          label.textContent = this.dataset.copied ?? "";
          announce(label.textContent);
          copy.dispatchEvent(new CustomEvent("skopli:event", { bubbles: true, detail: copy.dataset.event }));
        } catch {
          copy.dataset.state = "failed";
          label.textContent = this.dataset.copyFailed ?? "";
          announce(label.textContent);
        }
        setTimeout(() => {
          delete copy.dataset.state;
          label.textContent = idle;
        }, 2000);
      });

      const place = () => {
        const anchor = more.getBoundingClientRect();
        const below = window.innerHeight - anchor.bottom - 4;
        const above = anchor.top - 4;
        menu.style.maxHeight = "";
        const flip = below < menu.offsetHeight && above > below;
        menu.style.top = flip ? "auto" : `${anchor.bottom + 4}px`;
        menu.style.bottom = flip ? `${window.innerHeight - anchor.top + 4}px` : "auto";
        menu.style.maxHeight = `${Math.max(flip ? above : below, 0)}px`;
        menu.style.right = `${window.innerWidth - anchor.right}px`;
      };
      const setOpen = (open: boolean, focusIndex?: number) => {
        menu.hidden = !open;
        if (open) place();
        more.setAttribute("aria-expanded", String(open));
        if (open && focusIndex !== undefined) items[focusIndex]?.focus();
        if (!open && this.contains(document.activeElement)) more.focus();
      };

      more.addEventListener("click", () => setOpen(menu.hidden, 0));
      more.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          setOpen(true, event.key === "ArrowDown" ? 0 : items.length - 1);
        }
      });
      menu.addEventListener("keydown", (event) => {
        const index = items.indexOf(document.activeElement as HTMLAnchorElement);
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          const delta = event.key === "ArrowDown" ? 1 : -1;
          items[(index + delta + items.length) % items.length]?.focus();
        } else if (event.key === "Home" || event.key === "End") {
          event.preventDefault();
          items[event.key === "Home" ? 0 : items.length - 1]?.focus();
        }
      });
      this.addEventListener("focusout", (event) => {
        if (!this.contains(event.relatedTarget as Node | null)) this.close();
      });
      this.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !menu.hidden) {
          event.preventDefault();
          setOpen(false);
        }
      });
      this.close = () => {
        if (!menu.hidden) setOpen(false);
      };
      this.place = () => {
        if (menu.hidden) return;
        const anchor = more.getBoundingClientRect();
        const top = document.querySelector(".site-header")?.getBoundingClientRect().bottom ?? 0;
        const offscreen =
          anchor.bottom < top ||
          anchor.top > window.innerHeight ||
          anchor.right < 0 ||
          anchor.left > window.innerWidth;
        if (anchor.width === 0 || offscreen) setOpen(false);
        else place();
      };
    }
  }
  if (!customElements.get("skopli-page-actions")) {
    customElements.define("skopli-page-actions", SkopliPageActions);
    const all = () => document.querySelectorAll<SkopliPageActions>("skopli-page-actions");
    document.addEventListener("pointerdown", (event) => {
      for (const actions of all()) if (!actions.contains(event.target as Node)) actions.close();
    });
    const replace = () => all().forEach((a) => a.place());
    document.addEventListener("scroll", replace, { capture: true, passive: true });
    window.addEventListener("resize", replace);
  }
</script>
