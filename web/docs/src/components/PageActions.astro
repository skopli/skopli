---
// Hand-rolled "Copy page" split-button + dropdown (Copy page / View as
// Markdown / Open in ChatGPT / Open in Claude), styled on the shared token
// system. Flat, keyboard-accessible, 44px targets. No plugin.
//
// ChatGPT/Claude links must use the canonical production origin even in dev,
// because the LLM must be able to fetch a public URL. The raw `.md` endpoint
// is same-origin so "Copy page" and "View as Markdown" work locally too.

const CANONICAL_ORIGIN = "https://docs.skopli.com";

// Path within the site, e.g. "/skopli/guide/getting-started/".
const path = Astro.url.pathname;
// Strip trailing slash, append ".md" for the raw markdown route.
const mdPath = `${path.replace(/\/$/, "")}.md`;

// Local (same-origin) raw markdown URL — resolves in dev and prod.
const localMdUrl = mdPath;
// Canonical public URLs for the LLM handoff links.
const canonicalPageUrl = `${CANONICAL_ORIGIN}${path}`;
const canonicalMdUrl = `${CANONICAL_ORIGIN}${mdPath}`;

const prompt = `Read ${canonicalMdUrl} so I can ask questions about it`;
const chatgptUrl = `https://chatgpt.com/?q=${encodeURIComponent(prompt)}`;
const claudeUrl = `https://claude.ai/new?q=${encodeURIComponent(prompt)}`;
---

<page-actions class="page-actions" data-md-url={localMdUrl} data-page-url={canonicalPageUrl}>
  <button
    type="button"
    class="page-actions__copy"
    data-copy
    aria-label="Copy this page as Markdown"
  >
    <svg
      class="page-actions__icon"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="9" y="9" width="13" height="13" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <span data-copy-label>Copy page</span>
  </button>
  <button
    type="button"
    class="page-actions__toggle"
    data-toggle
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="More page actions"
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </button>
  <div class="page-actions__menu" data-menu role="menu" hidden>
    <a class="page-actions__item" role="menuitem" href={localMdUrl} target="_blank" rel="noopener">
      View as Markdown
    </a>
    <a class="page-actions__item" role="menuitem" href={chatgptUrl} target="_blank" rel="noopener">
      <svg
        class="page-actions__icon"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303l-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z"
        ></path>
      </svg>
      Open in ChatGPT
    </a>
    <a class="page-actions__item" role="menuitem" href={claudeUrl} target="_blank" rel="noopener">
      <svg
        class="page-actions__icon"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z"
        ></path>
      </svg>
      Open in Claude
    </a>
  </div>
</page-actions>

<style>
  .page-actions {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    flex: 0 0 auto;
    border: var(--hair) solid var(--rule-2);
    border-radius: var(--r-2);
    background: var(--ground-1);
  }
  .page-actions__copy,
  .page-actions__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-4);
    border: 0;
    background: none;
    color: var(--ink-1);
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: color var(--instant), background var(--instant);
  }
  .page-actions__copy {
    border-radius: var(--r-2) 0 0 var(--r-2);
  }
  .page-actions__toggle {
    padding: 0 var(--s-3);
    border-left: var(--hair) solid var(--rule-2);
    border-radius: 0 var(--r-2) var(--r-2) 0;
  }
  .page-actions__copy:hover,
  .page-actions__toggle:hover {
    color: var(--ink-0);
    background: var(--ground-2);
  }
  .page-actions__copy:focus-visible,
  .page-actions__toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .page-actions__icon {
    flex: 0 0 auto;
    color: var(--ink-2);
  }
  .page-actions__menu {
    position: absolute;
    top: calc(100% + 4px);
    right: 0;
    z-index: 30;
    min-width: 100%;
    width: max-content;
    display: flex;
    flex-direction: column;
    padding: var(--s-1);
    border: var(--hair) solid var(--rule-2);
    border-radius: var(--r-2);
    background: var(--ground-1);
  }
  .page-actions__menu[hidden] {
    display: none;
  }
  .page-actions__item {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding: 0 var(--s-4);
    border-radius: var(--r-1);
    color: var(--ink-1);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .page-actions__item:hover {
    color: var(--ink-0);
    background: var(--ground-2);
  }
  .page-actions__item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .page-actions__copy,
    .page-actions__toggle {
      transition: none;
    }
  }
</style>

<script>
  class PageActions extends HTMLElement {
    connectedCallback() {
      const copyBtn = this.querySelector<HTMLButtonElement>("[data-copy]");
      const toggleBtn = this.querySelector<HTMLButtonElement>("[data-toggle]");
      const menu = this.querySelector<HTMLElement>("[data-menu]");
      const copyLabel = this.querySelector<HTMLElement>("[data-copy-label]");
      const mdUrl = this.dataset.mdUrl ?? "";
      if (!copyBtn || !toggleBtn || !menu || !copyLabel) return;

      const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>("[role='menuitem']"));

      const openMenu = () => {
        menu.hidden = false;
        toggleBtn.setAttribute("aria-expanded", "true");
      };
      const closeMenu = () => {
        menu.hidden = true;
        toggleBtn.setAttribute("aria-expanded", "false");
      };
      const isOpen = () => !menu.hidden;

      toggleBtn.addEventListener("click", () => {
        if (isOpen()) {
          closeMenu();
        } else {
          openMenu();
          items[0]?.focus();
        }
      });

      this.addEventListener("keydown", (event) => {
        if (!isOpen()) return;
        if (event.key === "Escape") {
          closeMenu();
          toggleBtn.focus();
          return;
        }
        const idx = items.indexOf(document.activeElement as HTMLAnchorElement);
        if (event.key === "ArrowDown") {
          event.preventDefault();
          items[Math.min(idx + 1, items.length - 1)]?.focus();
        } else if (event.key === "ArrowUp") {
          event.preventDefault();
          if (idx <= 0) toggleBtn.focus();
          else items[idx - 1]?.focus();
        }
      });

      document.addEventListener("click", (event) => {
        if (isOpen() && !this.contains(event.target as Node)) closeMenu();
      });

      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      copyBtn.addEventListener("click", async () => {
        try {
          const res = await fetch(mdUrl);
          const text = await res.text();
          await navigator.clipboard.writeText(text);
          copyLabel.textContent = "Copied";
        } catch {
          copyLabel.textContent = "Copy failed";
        }
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          copyLabel.textContent = "Copy page";
        }, 2000);
      });
    }
  }
  customElements.define("page-actions", PageActions);
</script>
