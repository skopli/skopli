---
import Icon from "@skopli/ui/components/Icon.astro";
import { SITE, mdPath } from "../nav";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const md = mdPath(slug);
const absolute = `${SITE}${md}`;
const prompt = encodeURIComponent(`Read ${absolute} so I can ask questions about it.`);
const targets = [
  { name: "ChatGPT", icon: "chatgpt", href: `https://chatgpt.com/?q=${prompt}` },
  { name: "Claude", icon: "claude", href: `https://claude.ai/new?q=${prompt}` },
  { name: "Grok", icon: "grok", href: `https://grok.com/?q=${prompt}` },
  { name: "Perplexity", icon: "perplexity", href: `https://www.perplexity.ai/search?q=${prompt}` },
  { name: "Google AI Mode", icon: "google", href: `https://www.google.com/search?udm=50&q=${prompt}` },
  { name: "Cursor", icon: "cursor", href: `cursor://anysphere.cursor-deeplink/prompt?text=${prompt}` },
];
---

<div class="actions" data-actions data-md={md} data-link={absolute}>
  <button class="actions__btn actions__copy" type="button" data-copy>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="1.5" />
      <path d="M5 15V5.5A1.5 1.5 0 0 1 6.5 4H15" />
    </svg>
    <span class="actions__label" data-copy-label aria-live="polite">Copy page</span>
  </button>
  <button
    class="actions__btn actions__more"
    type="button"
    data-more
    aria-label="More actions"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="page-actions-menu"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>
  <ul class="actions__menu" id="page-actions-menu" role="menu" aria-label="Page actions">
    <li role="none">
      <a role="menuitem" tabindex="-1" href={md}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="1.5" />
          <path d="M7 15V9l2.5 3L12 9v6M16 9v6M14 13l2 2 2-2" />
        </svg>
        View as Markdown
      </a>
    </li>
    <li role="none">
      <button role="menuitem" tabindex="-1" type="button" data-copy-link>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1.2 1.2" />
          <path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1.2-1.2" />
        </svg>
        Copy Markdown link
      </button>
    </li>
    <li role="separator"></li>
    {targets.map(({ name, icon, href }) => (
      <li role="none">
        <a role="menuitem" tabindex="-1" href={href} rel="noopener"><Icon name={icon} />Open in {name}</a>
      </li>
    ))}
  </ul>
</div>
<script is:inline>document.querySelector("[data-actions]").dataset.enhanced = "";</script>

<script>
  const root = document.querySelector<HTMLElement>("[data-actions]");
  const copy = root?.querySelector<HTMLButtonElement>("[data-copy]");
  const more = root?.querySelector<HTMLButtonElement>("[data-more]");
  const menu = root?.querySelector<HTMLElement>("[role=menu]");
  const label = root?.querySelector<HTMLElement>("[data-copy-label]");
  const { md, link } = root?.dataset ?? {};

  if (root && copy && more && menu && label && md && link) {
    const items = [...menu.querySelectorAll<HTMLElement>("[role=menuitem]")];
    const idle = label.textContent;
    let reset: number | undefined;

    const show = (message: string) => {
      label.textContent = message;
      clearTimeout(reset);
      reset = window.setTimeout(() => (label.textContent = idle), 1500);
    };
    const write = async (text: string | Promise<string>, done: string) => {
      try {
        await navigator.clipboard.writeText(await text);
        show(done);
      } catch {
        show("Copy failed");
      }
    };
    const pageMarkdown = async () => {
      const response = await fetch(md);
      if (!response.ok) throw new Error(String(response.status));
      return response.text();
    };

    const toggle = (open: boolean, focus?: number) => {
      more.setAttribute("aria-expanded", String(open));
      if (open && focus !== undefined) items.at(focus)?.focus();
    };
    const isOpen = () => more.getAttribute("aria-expanded") === "true";
    const close = () => {
      toggle(false);
      more.focus();
    };

    copy.addEventListener("click", () => write(pageMarkdown(), "Copied"));
    more.addEventListener("click", () => toggle(!isOpen()));
    more.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        toggle(true, event.key === "ArrowDown" ? 0 : -1);
      } else if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggle(!isOpen(), 0);
      }
    });
    menu.addEventListener("keydown", (event) => {
      const current = items.findIndex((item) => item === document.activeElement);
      const moves = new Map([
        ["ArrowDown", current + 1],
        ["ArrowUp", current - 1],
        ["Home", 0],
        ["End", -1],
      ]);
      const next = moves.get(event.key);
      if (next !== undefined) {
        event.preventDefault();
        items.at(next % items.length)?.focus();
      } else if (event.key === " ") {
        event.preventDefault();
        items[current]?.click();
      }
    });
    root.addEventListener("keydown", (event) => {
      if (!isOpen()) return;
      if (event.key === "Tab") toggle(false);
      if (event.key === "Escape") close();
    });
    menu.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const item = event.target.closest("[role=menuitem]");
      if (!item) return;
      if (item.hasAttribute("data-copy-link")) write(link, "Link copied");
      close();
    });
    document.addEventListener("pointerdown", (event) => {
      if (isOpen() && event.target instanceof Node && !root.contains(event.target)) toggle(false);
    });
  }
</script>
