---
import Icon from "@skopli/ui/components/Icon.astro";
import { EVENTS } from "@skopli/ui/analytics";
import { useTranslations, type Locale } from "@skopli/ui/i18n";

interface Props {
  locale: Locale;
  mdPath: string;
}

const { locale, mdPath } = Astro.props;
const t = useTranslations(locale);
const canonicalMdUrl = `https://docs.skopli.com${mdPath}`;
const prompt = t("actions.prompt", { url: canonicalMdUrl });
const q = encodeURIComponent(prompt);
const targets = [
  { text: t("actions.chatgpt"), href: `https://chatgpt.com/?q=${q}`, event: EVENTS.chatgpt },
  { text: t("actions.claude"), href: `https://claude.ai/new?q=${q}`, event: EVENTS.claude },
  { text: t("actions.grok"), href: `https://grok.com/?q=${q}`, event: EVENTS.grok },
  { text: t("actions.perplexity"), href: `https://www.perplexity.ai/search?q=${q}`, event: EVENTS.perplexity },
  { text: t("actions.googleAiMode"), href: `https://www.google.com/search?udm=50&q=${q}`, event: EVENTS.googleAiMode },
  { text: t("actions.cursor"), href: `https://cursor.com/link/prompt?text=${q}`, event: EVENTS.cursor },
];
---

<div class="actions" data-pagefind-ignore>
  <button
    class="btn"
    type="button"
    data-copy-md={mdPath}
    data-event-copy={EVENTS.copyMd}
    data-copied={t("actions.copied")}
    data-failed={t("actions.failed")}
  >
    <Icon name="copy" size={16} />
    <span aria-live="polite">{t("actions.copy")}</span>
  </button>
  <a class="btn" href={mdPath}>{t("actions.view")}</a>
  <details class="open-in">
    <summary class="btn">
      {t("actions.open")}
      <Icon name="chevron" size={16} />
    </summary>
    <ul>
      {
        targets.map((x) => (
          <li>
            <a href={x.href} target="_blank" rel="noopener" data-event={x.event}>
              {x.text}
              <Icon name="external" size={14} />
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</div>

<style>
  [data-copy-md] span {
    display: inline-block;
    min-width: 8.5em;
    text-align: start;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .open-in {
    position: relative;
  }

  summary {
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .open-in[open] summary :global(svg) {
    rotate: 180deg;
  }

  ul {
    position: absolute;
    z-index: 5;
    top: calc(100% + var(--space-1));
    inset-inline-start: 0;
    min-width: 12rem;
    list-style: none;
    padding: var(--space-1);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
  }

  ul a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--hit);
    padding-inline: var(--space-3);
    color: var(--fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  ul a:hover {
    background: var(--bg-raised);
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-md]");
  const label = button?.querySelector("span");
  button?.addEventListener("click", async () => {
    if (!label) return;
    const original = label.textContent;
    try {
      const res = await fetch(button.dataset.copyMd!);
      if (!res.ok) throw new Error(String(res.status));
      await navigator.clipboard.writeText(await res.text());
      window.posthog?.capture(button.dataset.eventCopy!);
      label.textContent = button.dataset.copied!;
    } catch {
      label.textContent = button.dataset.failed!;
    }
    setTimeout(() => (label.textContent = original), 1800);
  });

  const menu = document.querySelector<HTMLDetailsElement>(".open-in");
  document.addEventListener("click", (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.open) menu.open = false;
  });
</script>
