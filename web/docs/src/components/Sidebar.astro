---
import { nav, pagePath } from "../nav";

interface Props {
  current: string;
}
const { current } = Astro.props;
---

<nav id="sidebar" class="sidebar" aria-label="Docs">
  <a class="sidebar__link" href={pagePath("index")} aria-current={current === "index" ? "page" : undefined}>
    Overview
  </a>
  {nav.map((group) => (
    <section class="sidebar__group">
      <h2>{group.label}</h2>
      <ul>
        {group.items.map((item) => (
          <li>
            <a
              class="sidebar__link"
              href={pagePath(item.slug)}
              aria-current={current === item.slug ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</nav>
