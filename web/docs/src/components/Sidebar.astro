---
import type { Locale } from "@skopli/ui/i18n";
import { href, t as translate } from "../lib/i18n.ts";
import { nav } from "../nav.ts";

interface Props {
  locale: Locale;
  current: string;
  id?: string;
  label: string;
}

const { locale, current, id, label } = Astro.props;
const t = translate(locale);
---

<nav class="sidebar-nav" id={id} aria-label={label}>
  {
    nav.map((group) => (
      <section class="sidebar-group">
        <h2 class="sidebar-group__label">{t(group.label)}</h2>
        <ul>
          {group.items.map((item) => (
            <li>
              <a
                href={href(`/${item.slug}`, locale)}
                aria-current={item.slug === current ? "page" : undefined}
              >
                {t(item.title)}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  .sidebar-nav {
    display: grid;
    gap: var(--s-5);
    font-size: var(--fs-sm);
  }
  .sidebar-group__label {
    margin: 0 0 var(--s-2);
    padding: 0 var(--s-3);
    color: var(--ink-0);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  ul {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: var(--s-1) var(--s-3);
    border-radius: var(--r-2);
    color: var(--ink-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink-0);
    background: var(--ground-2);
  }
  a[aria-current="page"] {
    color: var(--ink-0);
    background: var(--accent-wash);
    font-weight: 500;
  }
  @media (pointer: coarse) {
    a {
      min-height: var(--target);
    }
  }
</style>
