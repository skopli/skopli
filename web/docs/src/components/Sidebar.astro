---
import type { Locale } from "@skopli/ui/i18n";
import { getNav, pageHref } from "../nav.ts";

interface Props {
  current: string;
  label: string;
  locale: Locale;
}

const { current, label, locale } = Astro.props;
const nav = await getNav(locale);
---

<nav class="sidebar-nav" id="sidebar-nav" aria-label={label} hidden>
  {
    nav.map((section) => (
      <section>
        <p class="eyebrow">{section.title}</p>
        <ul>
          {section.pages.map((p) => (
            <li>
              <a href={pageHref(p.slug)} aria-current={p.slug === current ? "page" : undefined}>
                {p.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</nav>

<style>
  .sidebar-nav[hidden] {
    display: none;
  }

  .sidebar-nav {
    display: grid;
    gap: var(--space-5);
  }

  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
  }

  a {
    display: flex;
    align-items: center;
    min-height: var(--hit);
    padding-inline: var(--space-2);
    margin-inline: calc(-1 * var(--space-2));
    color: var(--fg);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  a:hover {
    color: var(--accent);
  }

  a[aria-current="page"] {
    color: var(--accent);
    font-weight: 600;
  }
</style>
