---
import type { Translate } from "@skopli/ui/i18n";

interface Props {
  t: Translate;
}

const { t } = Astro.props;
---

<button
  type="button"
  class="drawer-open"
  data-drawer-open
  aria-label={t("openMenu")}
  aria-controls="drawer"
  aria-expanded="false"
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </svg>
</button>

<dialog class="drawer" id="drawer" data-drawer aria-label={t("mainNavigation")}>
  <div class="drawer__head">
    <span class="drawer__title">{t("docs")}</span>
    <button type="button" class="drawer__close" data-drawer-close aria-label={t("closeMenu")}>
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>
  <div class="drawer__body">
    <slot />
  </div>
</dialog>

<style>
  .drawer-open {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: var(--target);
    min-height: var(--target);
    margin-inline-start: calc(-1 * var(--s-2));
    padding: 0;
    border: 0;
    border-radius: var(--r-2);
    background: none;
    color: var(--ink-1);
    cursor: pointer;
  }
  .drawer-open:hover {
    color: var(--ink-0);
    background: var(--ground-2);
  }
  @media (max-width: 63.99rem) {
    .drawer-open {
      display: inline-flex;
    }
  }
  .drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(20rem, 85vw);
    max-width: none;
    max-height: none;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-inline-end: var(--hair) solid var(--rule-1);
    background: var(--ground-0);
    color: var(--ink-1);
  }
  .drawer::backdrop {
    background: rgb(0 0 0 / 0.6);
  }
  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    padding: 0 var(--s-2) 0 var(--s-4);
    border-bottom: var(--hair) solid var(--rule-1);
  }
  .drawer__title {
    color: var(--ink-0);
    font-weight: 600;
  }
  .drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--target);
    min-height: var(--target);
    padding: 0;
    border: 0;
    border-radius: var(--r-2);
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }
  .drawer__close:hover {
    color: var(--ink-0);
    background: var(--ground-2);
  }
  .drawer__body {
    height: calc(100% - var(--header-h));
    padding: var(--s-4);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  :global(body:has(.drawer[open])) {
    overflow: hidden;
  }
</style>

<script>
  const drawer = document.querySelector<HTMLDialogElement>("[data-drawer]");
  const opener = document.querySelector<HTMLButtonElement>("[data-drawer-open]");
  if (drawer && opener) {
    opener.addEventListener("click", () => {
      drawer.showModal();
      opener.setAttribute("aria-expanded", "true");
    });
    drawer.addEventListener("close", () => opener.setAttribute("aria-expanded", "false"));
    drawer.querySelector("[data-drawer-close]")?.addEventListener("click", () => drawer.close());
    drawer.addEventListener("click", (event) => {
      if (event.target === drawer) drawer.close();
    });
    drawer.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const stops = [...drawer.querySelectorAll<HTMLElement>("a[href], button:not([disabled])")];
      const first = stops[0];
      const last = stops.at(-1);
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    const mq = window.matchMedia("(min-width: 48rem)");
    mq.addEventListener("change", () => {
      if (mq.matches && drawer.open) drawer.close();
    });
  }
</script>
