---
import Icon from "@skopli/ui/components/Icon.astro";
import { harnesses } from "@skopli/ui/harnesses";
---

<table class="harness-table">
  <thead>
    <tr>
      <th>Harness</th>
      <th>id</th>
    </tr>
  </thead>
  <tbody>
    {harnesses.map((h) => (
      <tr>
        <td>
          <span class="harness-table__name">
            {h.icon ? <Icon name={h.id} /> : <span class="harness-table__blank" aria-hidden="true" />}
            {h.name}
          </span>
        </td>
        <td><code>{h.id}</code></td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .harness-table th:first-child {
    width: 70%;
  }
  .harness-table__name {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }
  .harness-table__blank {
    display: inline-block;
    width: 16px;
    height: 16px;
  }
</style>
