{
  "name": "@skopli/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist/skopli",
    "preview": "astro preview",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "typecheck": "astro check",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck"
  },
  "dependencies": {
    "@skopli/ui": "workspace:*",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "pagefind": "1.5.2",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
