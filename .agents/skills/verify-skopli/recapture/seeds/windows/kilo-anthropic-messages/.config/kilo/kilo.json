{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama/qwen",
  "permission": {
    "*": "allow",
    "bash": "allow"
  },
  "provider": {
    "llama": {
      "npm": "@ai-sdk/anthropic",
      "name": "llama.cpp",
      "options": {
        "baseURL": "{origin}/v1",
        "apiKey": "sk-local"
      },
      "models": {
        "qwen": {
          "name": "qwen",
          "limit": {
            "context": 32768,
            "output": 1024
          }
        }
      }
    }
  }
}
