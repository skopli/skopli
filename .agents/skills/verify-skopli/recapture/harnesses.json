        }
      }
    },
    "kimchi": {
      "install": {
        "pnpm": "@getkimchi/kimchi"
      },
      "store": [".config/kimchi/agent/sessions", ".pi/agent/sessions"],
      "shapes": {
        "openai-chat": {
          "first": ["kimchi", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["kimchi", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".config/kimchi/agent/models.json"
          },
          "seed": "kimchi-openai-chat"
        },
        "openai-responses": {
          "first": ["kimchi", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["kimchi", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".config/kimchi/agent/models.json"
          },
          "seed": "kimchi-openai-responses"
        },
        "anthropic-messages": {
          "first": ["kimchi", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["kimchi", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".config/kimchi/agent/models.json"
          },
          "seed": "kimchi-anthropic-messages"
        }
      }
    },
    "grok": {
      "install": {
        "script": "https://x.ai/cli/install.sh"
      },
      "installOs": { "windows": { "ps1": "https://x.ai/cli/install.ps1" } },
      "store": [".grok", ".grok/logs", ".grok/sessions"],
      "shapes": {
        "openai-chat": {
          "first": ["grok", "--always-approve", "-m", "qwen", "-p", "{prompt}"],
          "next": ["grok", "--always-approve", "-m", "qwen", "--continue", "-p", "{prompt}"],
          "env": {
            "XAI_API_KEY": "sk-local",
            "GROK_HOME": "{home}/.grok"
          },
          "seed": "grok-openai-chat",
          "skipOs": {
            "darwin": "no-byok-endpoint"
          }
        },
