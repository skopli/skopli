{
  "prompts": [
    "What does index.js in this project export? Answer in one sentence.",
    "Given what index.js exports, what does the concurrency argument control? One sentence.",
    "Why does the limiter need a queue when more tasks arrive than the concurrency allows? One sentence.",
    "Summarise the three answers you gave so far in one sentence."
  ],
  "harnesses": {
    "claude": {
      "install": {
        "pnpm": "@anthropic-ai/claude-code"
      },
      "store": [".claude/projects"],
      "shapes": {
        "openai-chat": {
          "skip": "wrong-wire-shape",
          "note": "Claude Code speaks the Anthropic Messages API only (ANTHROPIC_BASE_URL); no OpenAI wire option"
        },
        "openai-responses": {
          "skip": "wrong-wire-shape",
          "note": "Claude Code speaks the Anthropic Messages API only; no OpenAI wire option"
        },
        "anthropic-messages": {
          "first": [
            "claude",
            "-p",
            "--dangerously-skip-permissions",
            "--model",
            "qwen",
            "{prompt}"
          ],
          "next": [
            "claude",
            "-p",
            "-c",
            "--dangerously-skip-permissions",
            "--model",
            "qwen",
            "{prompt}"
          ],
          "seed": "claude-anthropic-messages"
        }
      }
    },
    "codex": {
      "install": {
        "pnpm": "@openai/codex"
      },
      "store": [".codex/history.jsonl", ".codex/sessions"],
      "shapes": {
        "openai-chat": {
          "skip": "wrong-wire-shape",
          "note": "codex 0.163 rejects wire_api=\"chat\" in config.toml and exits asking for the Responses API; run.txt kept, no session written"
        },
        "openai-responses": {
          "first": ["codex", "exec", "--skip-git-repo-check", "{prompt}"],
          "next": ["codex", "exec", "resume", "--last", "--skip-git-repo-check", "{prompt}"],
          "env": {
            "LLAMA_API_KEY": "sk-local",
            "CODEX_HOME": "{home}/.codex"
          },
          "seed": "codex-openai-responses"
        },
        "anthropic-messages": {
          "skip": "wrong-wire-shape",
          "note": "Codex has no Anthropic Messages client (OpenAI Responses/Chat providers only)"
        }
      }
    },
    "gemini": {
      "install": {
        "pnpm": "@google/gemini-cli"
      },
      "store": [".gemini/tmp"],
      "shapes": {
        "openai-chat": {
          "skip": "wrong-wire-shape",
          "note": "Gemini CLI speaks the Gemini generateContent API only (GEMINI_API_KEY / Vertex / Code Assist); no OpenAI-compatible provider setting"
        },
        "openai-responses": {
          "skip": "wrong-wire-shape",
          "note": "no OpenAI provider in Gemini CLI"
        },
        "anthropic-messages": {
          "skip": "wrong-wire-shape",
          "note": "no Anthropic provider in Gemini CLI"
        }
      }
    },
    "opencode": {
      "install": {
        "pnpm": "opencode-ai"
      },
      "store": [".local/share/opencode"],
      "shapes": {
        "openai-chat": {
          "first": ["opencode", "run", "--model", "llama/qwen", "{prompt}"],
          "next": ["opencode", "run", "--continue", "--model", "llama/qwen", "{prompt}"],
          "env": {
            "OPENCODE_CONFIG": "{home}/.config/opencode/opencode.json"
          },
          "config": {
            "kind": "opencode",
            "path": ".config/opencode/opencode.json"
          },
          "seed": "opencode-openai-chat"
        },
        "openai-responses": {
          "first": ["opencode", "run", "--model", "llama/qwen", "{prompt}"],
          "next": ["opencode", "run", "--continue", "--model", "llama/qwen", "{prompt}"],
          "env": {
            "OPENCODE_CONFIG": "{home}/.config/opencode/opencode.json"
          },
          "config": {
            "kind": "opencode",
            "path": ".config/opencode/opencode.json"
          },
          "seed": "opencode-openai-responses"
        },
        "anthropic-messages": {
          "first": ["opencode", "run", "--model", "llama/qwen", "{prompt}"],
          "next": ["opencode", "run", "--continue", "--model", "llama/qwen", "{prompt}"],
          "env": {
            "OPENCODE_CONFIG": "{home}/.config/opencode/opencode.json"
          },
          "config": {
            "kind": "opencode",
            "path": ".config/opencode/opencode.json"
          },
          "seed": "opencode-anthropic-messages"
        }
      }
    },
    "mimocode": {
      "install": {
        "script": "https://mimo.xiaomi.com/install"
      },
      "installOs": { "windows": { "ps1": "https://mimo.xiaomi.com/install.ps1" } },
      "store": [".local/share/mimocode", ".mimocode/data"],
      "shapes": {
        "openai-chat": {
          "first": ["mimo", "run", "--model", "llama/qwen", "{prompt}"],
          "next": ["mimo", "run", "--continue", "--model", "llama/qwen", "{prompt}"],
          "env": {
            "MIMOCODE_CONFIG": "{home}/.config/mimocode/mimocode.json",
            "OPENCODE_CONFIG": "{home}/.config/mimocode/mimocode.json"
          },
          "config": {
            "kind": "opencode",
            "path": ".config/mimocode/mimocode.json"
          },
          "seed": "mimocode-openai-chat"
        },
        "openai-responses": {
          "first": ["mimo", "run", "--model", "llama/qwen", "{prompt}"],
          "next": ["mimo", "run", "--continue", "--model", "llama/qwen", "{prompt}"],
          "env": {
            "MIMOCODE_CONFIG": "{home}/.config/mimocode/mimocode.json",
            "OPENCODE_CONFIG": "{home}/.config/mimocode/mimocode.json"
          },
          "config": {
            "kind": "opencode",
            "path": ".config/mimocode/mimocode.json"
          },
          "seed": "mimocode-openai-responses",
          "nextFrom": "openai-chat"
        },
        "anthropic-messages": {
          "first": ["mimo", "run", "--model", "llama/qwen", "{prompt}"],
          "next": ["mimo", "run", "--continue", "--model", "llama/qwen", "{prompt}"],
          "env": {
            "MIMOCODE_CONFIG": "{home}/.config/mimocode/mimocode.json",
            "OPENCODE_CONFIG": "{home}/.config/mimocode/mimocode.json"
          },
          "config": {
            "kind": "opencode",
            "path": ".config/mimocode/mimocode.json"
          },
          "seed": "mimocode-anthropic-messages"
        }
      }
    },
    "commandcode": {
      "install": {
        "pnpm": "command-code"
      },
      "store": [".commandcode"],
      "shapes": {
        "openai-chat": {
          "first": [
            "commandcode",
            "--local-only",
            "--skip-onboarding",
            "--no-auto-update",
            "--yolo",
            "-m",
            "llama/qwen",
            "-p",
            "{prompt}"
          ],
          "next": [
            "commandcode",
            "--local-only",
            "--skip-onboarding",
            "--no-auto-update",
            "--yolo",
            "-m",
            "llama/qwen",
            "-c",
            "-p",
            "{prompt}"
          ],
          "env": {
            "COMMAND_CODE_API_KEY": "local-only-placeholder"
          },
          "seed": "commandcode-openai-chat"
        },
        "openai-responses": {
          "first": [
            "commandcode",
            "--local-only",
            "--skip-onboarding",
            "--no-auto-update",
            "--yolo",
            "-m",
            "llama/qwen",
            "-p",
            "{prompt}"
          ],
          "next": [
            "commandcode",
            "--local-only",
            "--skip-onboarding",
            "--no-auto-update",
            "--yolo",
            "-m",
            "llama/qwen",
            "-c",
            "-p",
            "{prompt}"
          ],
          "env": {
            "COMMAND_CODE_API_KEY": "local-only-placeholder"
          },
          "seed": "commandcode-openai-responses",
          "note": "historically a capture gap: the Responses client never completes a stream against the gateway"
        },
        "anthropic-messages": {
          "first": [
            "commandcode",
            "--local-only",
            "--skip-onboarding",
            "--no-auto-update",
            "--yolo",
            "-m",
            "llama/qwen",
            "-p",
            "{prompt}"
          ],
          "next": [
            "commandcode",
            "--local-only",
            "--skip-onboarding",
            "--no-auto-update",
            "--yolo",
            "-m",
            "llama/qwen",
            "-c",
            "-p",
            "{prompt}"
          ],
          "env": {
            "COMMAND_CODE_API_KEY": "local-only-placeholder"
          },
          "seed": "commandcode-anthropic-messages"
        }
      }
    },
    "copilot": {
      "install": {
        "pnpm": "@github/copilot"
      },
      "store": [".copilot"],
      "shapes": {
        "openai-chat": {
          "first": ["copilot", "-p", "{prompt}", "--allow-all-tools", "--allow-all-paths"],
          "next": [
            "copilot",
            "-p",
            "{prompt}",
            "--resume",
            "--allow-all-tools",
            "--allow-all-paths"
          ],
          "env": {
            "COPILOT_OTEL_ENABLED": "true",
            "COPILOT_OTEL_EXPORTER_TYPE": "file",
            "COPILOT_OTEL_FILE_EXPORTER_PATH": "{home}/.copilot/otel",
            "COPILOT_PROVIDER_BASE_URL": "{origin}/v1",
            "COPILOT_PROVIDER_TYPE": "openai",
            "COPILOT_PROVIDER_WIRE_API": "completions",
            "COPILOT_PROVIDER_API_KEY": "sk-local",
            "COPILOT_MODEL": "qwen",
            "COPILOT_PROVIDER_MAX_PROMPT_TOKENS": "30000"
          },
          "seed": "copilot-openai-chat"
        },
        "openai-responses": {
          "first": ["copilot", "-p", "{prompt}", "--allow-all-tools", "--allow-all-paths"],
          "next": [
            "copilot",
            "-p",
            "{prompt}",
            "--resume",
            "--allow-all-tools",
            "--allow-all-paths"
          ],
          "env": {
            "COPILOT_OTEL_ENABLED": "true",
            "COPILOT_OTEL_EXPORTER_TYPE": "file",
            "COPILOT_OTEL_FILE_EXPORTER_PATH": "{home}/.copilot/otel",
            "COPILOT_PROVIDER_BASE_URL": "{origin}/v1",
            "COPILOT_PROVIDER_TYPE": "openai",
            "COPILOT_PROVIDER_WIRE_API": "responses",
            "COPILOT_PROVIDER_API_KEY": "sk-local",
            "COPILOT_MODEL": "qwen",
            "COPILOT_PROVIDER_MAX_PROMPT_TOKENS": "30000"
          },
          "seed": "copilot-openai-responses"
        },
        "anthropic-messages": {
          "first": ["copilot", "-p", "{prompt}", "--allow-all-tools", "--allow-all-paths"],
          "next": [
            "copilot",
            "-p",
            "{prompt}",
            "--resume",
            "--allow-all-tools",
            "--allow-all-paths"
          ],
          "env": {
            "COPILOT_OTEL_ENABLED": "true",
            "COPILOT_OTEL_EXPORTER_TYPE": "file",
            "COPILOT_OTEL_FILE_EXPORTER_PATH": "{home}/.copilot/otel",
            "COPILOT_PROVIDER_BASE_URL": "{origin}",
            "COPILOT_PROVIDER_TYPE": "anthropic",
            "COPILOT_PROVIDER_API_KEY": "sk-local",
            "COPILOT_MODEL": "qwen",
            "COPILOT_PROVIDER_MAX_PROMPT_TOKENS": "30000"
          },
          "seed": "copilot-anthropic-messages"
        }
      }
    },
    "amp": {
      "install": {
        "pnpm": "@sourcegraph/amp"
      },
      "store": [".local/share/amp/threads"],
      "shapes": {
        "openai-chat": {
          "skip": "no-byok-endpoint",
          "note": "Amp CLI has no bring-your-own-endpoint setting; it only talks to ampcode.com after login (closed source, API key required)"
        },
        "openai-responses": {
          "skip": "no-byok-endpoint",
          "note": "no BYOK endpoint in Amp"
        },
        "anthropic-messages": {
          "skip": "no-byok-endpoint",
          "note": "no BYOK endpoint in Amp"
        }
      }
    },
    "droid": {
      "install": {
        "script": "https://app.factory.ai/cli"
      },
      "installOs": { "windows": { "ps1": "https://app.factory.ai/cli/windows" } },
      "store": [".factory/logs", ".factory/sessions"],
      "shapes": {
        "openai-chat": {
          "first": [
            "droid",
            "exec",
            "--auto",
            "high",
            "-m",
            "custom:qwen-0",
            "--output-format",
            "json",
            "{prompt}"
          ],
          "next": [
            "droid",
            "exec",
            "--auto",
            "high",
            "-m",
            "custom:qwen-0",
            "--output-format",
            "json",
            "-s",
            "{session}",
            "{prompt}"
          ],
          "seed": "droid-openai-chat"
        },
        "openai-responses": {
          "first": [
            "droid",
            "exec",
            "--auto",
            "high",
            "-m",
            "custom:qwen-0",
            "--output-format",
            "json",
            "{prompt}"
          ],
          "next": [
            "droid",
            "exec",
            "--auto",
            "high",
            "-m",
            "custom:qwen-0",
            "--output-format",
            "json",
            "-s",
            "{session}",
            "{prompt}"
          ],
          "seed": "droid-openai-responses"
        },
        "anthropic-messages": {
          "first": [
            "droid",
            "exec",
            "--auto",
            "high",
            "-m",
            "custom:qwen-0",
            "--output-format",
            "json",
            "{prompt}"
          ],
          "next": [
            "droid",
            "exec",
            "--auto",
            "high",
            "-m",
            "custom:qwen-0",
            "--output-format",
            "json",
            "-s",
            "{session}",
            "{prompt}"
          ],
          "seed": "droid-anthropic-messages"
        }
      },
      "session": {
        "stdout": "\"session_id\":\"([0-9a-f-]+)\""
      }
    },
    "qwen": {
      "install": {
        "pnpm": "@qwen-code/qwen-code"
      },
      "store": [".qwen/projects"],
      "shapes": {
        "openai-chat": {
          "first": ["qwen", "-p", "{prompt}", "-y"],
          "next": ["qwen", "-p", "{prompt}", "-y", "--continue"],
          "env": {
            "OPENAI_BASE_URL": "{origin}/v1",
            "OPENAI_API_KEY": "sk-local",
            "OPENAI_MODEL": "qwen",
            "QWEN_CODE_SUPPRESS_YOLO_WARNING": "1"
          }
        },
        "openai-responses": {
          "skip": "wrong-wire-shape",
          "note": "Qwen Code (Gemini CLI fork) only has an OpenAI Chat Completions provider; no Responses wire option"
        },
        "anthropic-messages": {
          "skip": "wrong-wire-shape",
          "note": "no Anthropic provider in Qwen Code"
        }
      }
    },
    "pi": {
      "install": {
        "pnpm": "@mariozechner/pi-coding-agent"
      },
      "store": [".pi/agent/sessions"],
      "shapes": {
        "openai-chat": {
          "first": [
            "pi",
            "-p",
            "--provider",
            "llama",
            "--model",
            "qwen",
            "--no-extensions",
            "--no-skills",
            "{prompt}"
          ],
          "next": [
            "pi",
            "-p",
            "-c",
            "--provider",
            "llama",
            "--model",
            "qwen",
            "--no-extensions",
            "--no-skills",
            "{prompt}"
          ],
          "config": {
            "kind": "pi",
            "path": ".pi/agent/models.json"
          },
          "seed": "pi-openai-chat"
        },
        "openai-responses": {
          "first": [
            "pi",
            "-p",
            "--provider",
            "llama",
            "--model",
            "qwen",
            "--no-extensions",
            "--no-skills",
            "{prompt}"
          ],
          "next": [
            "pi",
            "-p",
            "-c",
            "--provider",
            "llama",
            "--model",
            "qwen",
            "--no-extensions",
            "--no-skills",
            "{prompt}"
          ],
          "config": {
            "kind": "pi",
            "path": ".pi/agent/models.json"
          },
          "seed": "pi-openai-responses"
        },
        "anthropic-messages": {
          "first": [
            "pi",
            "-p",
            "--provider",
            "llama",
            "--model",
            "qwen",
            "--no-extensions",
            "--no-skills",
            "{prompt}"
          ],
          "next": [
            "pi",
            "-p",
            "-c",
            "--provider",
            "llama",
            "--model",
            "qwen",
            "--no-extensions",
            "--no-skills",
            "{prompt}"
          ],
          "config": {
            "kind": "pi",
            "path": ".pi/agent/models.json"
          },
          "seed": "pi-anthropic-messages"
        }
      }
    },
    "omp": {
      "install": {
        "pnpm": "@oh-my-pi/pi-coding-agent"
      },
      "store": [".omp/agent/sessions"],
      "shapes": {
        "openai-chat": {
          "first": ["omp", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["omp", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".omp/agent/models.json"
          },
          "seed": "omp-openai-chat"
        },
        "openai-responses": {
          "first": ["omp", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["omp", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".omp/agent/models.json"
          },
          "seed": "omp-openai-responses"
        },
        "anthropic-messages": {
          "first": ["omp", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["omp", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".omp/agent/models.json"
          },
          "seed": "omp-anthropic-messages"
        }
      }
    },
    "prime": {
      "install": {
        "script": "https://app.primeintellect.ai/prime-agent/install.sh"
      },
      "installOs": {
        "windows": { "ps1": "https://app.primeintellect.ai/prime-agent/install.ps1" }
      },
      "store": [".prime/agent/sessions"],
      "shapes": {
        "openai-chat": {
          "first": ["prime-agent", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["prime-agent", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".prime/agent/models.json"
          },
          "seed": "prime-openai-chat"
        },
        "openai-responses": {
          "first": ["prime-agent", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["prime-agent", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".prime/agent/models.json"
          },
          "seed": "prime-openai-responses"
