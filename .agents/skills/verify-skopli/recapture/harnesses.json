          "next": ["prime-agent", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".prime/agent/models.json"
          },
          "seed": "prime-anthropic-messages"
        }
      }
    },
    "gajae": {
      "install": {
        "pnpm": "gajae-code"
      },
      "store": [".gjc/agent/sessions"],
      "shapes": {
        "openai-chat": {
          "first": ["gjc", "-p", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "next": ["gjc", "-p", "-c", "--provider", "llama", "--model", "qwen", "{prompt}"],
          "config": {
            "kind": "pi",
            "path": ".gjc/agent/models.json"
          },
          "seed": "gajae-openai-chat"
